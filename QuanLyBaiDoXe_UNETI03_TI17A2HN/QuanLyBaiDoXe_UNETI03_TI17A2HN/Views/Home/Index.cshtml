@* Họ và tên: Tăng Hoàng Giang *@
@* Mã sinh viên: 23103100031 *@
@* Nội dung thực hiện: Giao diện Trang chủ Dashboard tổng quan (Module 4) *@

@model QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.ViewModels.HomeDashboardViewModel

@{
    ViewData["Title"] = "Trang chủ - Quản lý bãi đỗ xe";
    string? vaiTro = Context.Session?.GetString("VaiTro");
}

<div class="container-fluid p-0">
    <!-- THÔNG BÁO FLASH MESSAGE -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @{
        string tenChao = Context.Session?.GetString("HoTen") ?? "bạn";
    }

    <!-- 1. BANNER CHÀO MỪNG (giống demo) -->
    <div class="ps-welcome">
        <div>
            <h2>Xin chào, @tenChao 👋</h2>
            <p>
                @(vaiTro == "Admin"
                    ? $"Hiện có {Model.SoDangGui} xe đang gửi trong bãi."
                    : $"Bạn đang có {Model.SoDangGui} xe gửi trong bãi. Chúc bạn một ngày thuận lợi!")
            </p>
        </div>
        <a asp-controller="PhieuGuiXes" asp-action="Create" class="btn btn-ac">Đăng ký gửi xe →</a>
    </div>

    <!-- 2. BỐN Ô SỐ LIỆU -->
    <div class="ps-kp">
        <div class="card"><div class="ps-ico">🚗</div><div><b>@Model.SoXeCuaToi</b><span>@(vaiTro == "Admin" ? "Phương tiện" : "Xe của tôi")</span></div></div>
        <div class="card"><div class="ps-ico">🕘</div><div><b>@Model.SoLuotGui</b><span>Lượt gửi</span></div></div>
        <div class="card"><div class="ps-ico">⏳</div><div><b>@Model.SoDangGui</b><span>Đang gửi</span></div></div>
        <div class="card"><div class="ps-ico">🅿️</div><div><b>@Model.TongViTriTrong</b><span>Chỗ trống</span></div></div>
    </div>

    <!-- 3. PHẦN DƯỚI: HOẠT ĐỘNG GẦN ĐÂY & FORM ĐĂNG KÝ NHANH -->
    <div class="row g-4">
        <!-- CỘT TRÁI: HOẠT ĐỘNG GẦN ĐÂY -->
        <div class="col-lg-8">
            <div class="dashboard-card">
                <h5 class="fw-bold text-dark mb-3">@(vaiTro == "Admin" ? "Hoạt động gần đây" : "Lượt gửi gần đây của bạn")</h5>

                <div class="table-responsive">
                    <table class="table align-middle table-borderless table-hover mb-0">
                        <thead>
                            <tr class="text-muted small border-bottom">
                                <th class="pb-3 fw-medium">Thời gian</th>
                                <th class="pb-3 fw-medium">Biển số xe</th>
                                <th class="pb-3 fw-medium">Loại xe</th>
                                <th class="pb-3 fw-medium">Vị trí đỗ</th>
                                <th class="pb-3 fw-medium text-center">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.HoatDongGanDay != null && Model.HoatDongGanDay.Any())
                            {
                                @foreach (var item in Model.HoatDongGanDay)
                                {
                                    <tr class="border-bottom">
                                        <td class="py-3 text-secondary" style="font-size: 13px;">
                                            @item.NgayDangKy.ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                        <td class="py-3 fw-semibold text-dark">
                                            @(item.PhuongTien?.BienSoXe ?? "---")
                                        </td>
                                        <td class="py-3 text-secondary">
                                            @(item.PhuongTien?.LoaiPhuongTien?.TenLoaiPhuongTien ?? "---")
                                        </td>
                                        <td class="py-3 text-secondary">
                                            @(item.ViTriDoXe?.TenViTri ?? "Chưa xếp")
                                        </td>
                                        <td class="py-3 text-center">
                                            @if (item.TrangThai == "Đang gửi")
                                            {
                                                <span class="badge-status status-dang-gui">Đang gửi</span>
                                            }
                                            else if (item.TrangThai == "Đã gửi" || item.TrangThai == "Hoàn thành")
                                            {
                                                <span class="badge-status status-da-gui">Đã gửi</span>
                                            }
                                            else if (item.TrangThai == "Chờ xác nhận")
                                            {
                                                <span class="badge-status status-cho-xac-nhan">Chờ xác nhận</span>
                                            }
                                            else
                                            {
                                                <span class="badge-status status-khac">@item.TrangThai</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                        Chưa có hoạt động gửi xe nào gần đây.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-3 pt-2">
                    <a asp-controller="PhieuGuiXes" asp-action="Index" class="text-primary text-decoration-none fw-semibold small d-inline-flex align-items-center gap-1">
                        <span>@(vaiTro == "Khách hàng" ? "Xem lịch sử gửi xe" : "Xem tất cả")</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: ĐĂNG KÝ GỬI XE NHANH -->
        <div class="col-lg-4">
            <div class="dashboard-card">
                <h5 class="fw-bold text-dark mb-3">Đăng ký gửi xe nhanh</h5>

                <form asp-controller="Home" asp-action="DangKyNhanh" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary mb-1">
                            Biển số xe <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted" style="border-radius: 10px 0 0 10px;">
                                <i class="bi bi-car-front"></i>
                            </span>
                            <input type="text" name="bienSoXe" class="form-control form-control-dash border-start-0"
                                   style="border-radius: 0 10px 10px 0;" placeholder="Nhập biển số xe (VD: 30A-123.45)" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary mb-1">
                            Loại xe <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted" style="border-radius: 10px 0 0 10px;">
                                <i class="bi bi-truck"></i>
                            </span>
                            <select name="maLoaiPhuongTien" class="form-select form-select-dash border-start-0"
                                    style="border-radius: 0 10px 10px 0;" required>
                                <option value="">Chọn loại xe</option>
                                @if (Model.DanhSachLoaiXe != null)
                                {
                                    @foreach (var loai in Model.DanhSachLoaiXe)
                                    {
                                        <option value="@loai.MaLoaiPhuongTien">@loai.TenLoaiPhuongTien</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary mb-1">
                            Thời gian gửi <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted" style="border-radius: 10px 0 0 10px;">
                                <i class="bi bi-calendar3"></i>
                            </span>
                            <input type="datetime-local" name="thoiGianVao" class="form-control form-control-dash border-start-0"
                                   style="border-radius: 0 10px 10px 0;" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-semibold text-secondary mb-1">Ghi chú (nếu có)</label>
                        <input type="text" name="ghiChu" class="form-control form-control-dash" placeholder="Nhập ghi chú..." />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-send-fill"></i>
                        <span>Đăng ký</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
