@model QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.ChuPhuongTien

@{
    ViewData["Title"] = "Cập nhật Chủ phương tiện";
}

<div class="row justify-content-center mt-0">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow">
            <div class="card-header bg-warning text-dark text-center">
                <h3 class="mb-0">Cập nhật thông tin Chủ phương tiện</h3>
            </div>
            <div class="card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <!-- Khóa chính ẩn để định danh bản ghi -->
                    <input type="hidden" asp-for="MaChuPhuongTien" />

                    <!-- Mã tài khoản liên kết -->
                    <div class="form-group mb-3">
                        <label asp-for="MaTaiKhoan" class="control-label font-weight-bold">Tài khoản liên kết (*)</label>
                        <select asp-for="MaTaiKhoan" class="form-select" asp-items="ViewBag.MaTaiKhoan"></select>
                        <span asp-validation-for="MaTaiKhoan" class="text-danger"></span>
                    </div>

                    <!-- Họ tên -->
                    <div class="form-group mb-3">
                        <label asp-for="HoTen" class="control-label font-weight-bold">Họ tên (*)</label>
                        <input asp-for="HoTen" class="form-control" required placeholder="Nhập họ và tên..." />
                        <span asp-validation-for="HoTen" class="text-danger"></span>
                    </div>

                    <!-- Ngày sinh -->
                    <div class="form-group mb-3">
                        <label asp-for="NgaySinh" class="control-label font-weight-bold">Ngày sinh</label>
                        <input asp-for="NgaySinh" type="date" class="form-control" />
                        <span asp-validation-for="NgaySinh" class="text-danger"></span>
                    </div>

                    <!-- Giới tính (Dùng thẻ select để chọn Nam/Nữ chính xác) -->
                    <div class="form-group mb-3">
                        <label asp-for="GioiTinh" class="control-label font-weight-bold">Giới tính (*)</label>
                        <select asp-for="GioiTinh" class="form-select">
                            <option value="true">Nam</option>
                            <option value="false">Nữ</option>
                        </select>
                        <span asp-validation-for="GioiTinh" class="text-danger"></span>
                    </div>

                    <!-- Số điện thoại -->
                    <div class="form-group mb-3">
                        <label asp-for="SoDienThoai" class="control-label font-weight-bold">Số điện thoại (*)</label>
                        <input asp-for="SoDienThoai" class="form-control" required placeholder="Nhập số điện thoại..." />
                        <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                    </div>

                    <!-- Email -->
                    <div class="form-group mb-3">
                        <label asp-for="Email" class="control-label font-weight-bold">Email (*)</label>
                        <input asp-for="Email" type="email" class="form-control" required placeholder="Nhập địa chỉ email..." />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <!-- Địa chỉ -->
                    <div class="form-group mb-3">
                        <label asp-for="DiaChi" class="control-label font-weight-bold">Địa chỉ</label>
                        <input asp-for="DiaChi" class="form-control" placeholder="Nhập địa chỉ..." />
                        <span asp-validation-for="DiaChi" class="text-danger"></span>
                    </div>

                    <!-- Ngày đăng ký (Ẩn hoặc hiển thị dạng read-only tùy ý, ở đây dùng hidden giữ nguyên giá trị cũ) -->
                    <input type="hidden" asp-for="NgayDangKy" />

                    <!-- Trạng thái tài khoản -->
                    <div class="form-group mb-3">
                        <label asp-for="TrangThai" class="control-label font-weight-bold">Trạng thái tài khoản</label>
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" asp-for="TrangThai" id="trangThaiSwitch">
                            <label class="form-check-label" for="trangThaiSwitch">Kích hoạt</label>
                        </div>
                        <span asp-validation-for="TrangThai" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Trở về danh sách</a>
                        <input type="submit" value="Lưu thay đổi" class="btn btn-warning px-4 font-weight-bold" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
