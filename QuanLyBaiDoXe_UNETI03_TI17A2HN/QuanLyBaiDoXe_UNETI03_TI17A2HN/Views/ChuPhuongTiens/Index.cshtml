@model IEnumerable<QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.ChuPhuongTien>

@{
    ViewData["Title"] = "Index";
}

<h1>Danh sách chủ phương tiện</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Tạo mới</a>
</p>
<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>
                Mã tài khoản
            </th>
            <th>
                Họ tên
            </th>
            <th>
                Ngày sinh
            </th>
            <th>
                Giới tính
            </th>
            <th>
                Số điện thoại
            </th>
            <th>
                Email
            </th>
            <th>
                Địa chỉ
            </th>
            <th>
                Ngày đăng ký
            </th>
            <th>
                Trạng thái 
            </th>
            <th>
                Tên đăng nhập
            </th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.MaTaiKhoan)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.HoTen)
            </td>
            <td>
                @string.Format("{0:dd/MM/yyyy}", item.NgaySinh)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GioiTinh)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SoDienThoai)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DiaChi)
            </td>
            <td>
                @string.Format("{0:dd/MM/yyyy}", item.NgayDangKy)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TrangThai)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TaiKhoan.TenDangNhap)
            </td>
            <td>
                <a asp-action="Edit" asp-route-machuphuongtien="@item.MaChuPhuongTien">Sửa</a> |
                <a asp-action="Details" asp-route-machuphuongtien="@item.MaChuPhuongTien">Chi tiết</a> |
                <a asp-action="Delete" asp-route-machuphuongtien="@item.MaChuPhuongTien">Xóa</a>
            </td>
        </tr>
}
    </tbody>
</table>