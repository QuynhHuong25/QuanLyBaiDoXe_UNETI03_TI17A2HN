@model QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.VeThang

@{
    ViewData["Title"] = "Thanh toán thành công";
    string soTien = Model.GiaTien.ToString("N0").Replace(",", ".");
}

<style>
    .tt-ok { max-width: 440px; margin: 0 auto; }
    .tt-ok .tt-icon { width: 64px; height: 64px; border-radius: 50%; background: #1f9d6b; color: #fff; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; font-size: 34px; box-shadow: 0 6px 16px rgba(31,157,107,.35); }
    .tt-ok .tt-title { color: #1f8a5f; font-weight: 700; font-size: 1.5rem; text-align: center; }
    .tt-ok .tt-amount { color: #1f8a5f; font-weight: 800; font-size: 1.75rem; text-align: center; }
    .tt-ok .tt-time { color: var(--mu, #64748b); text-align: center; font-size: .9rem; margin-bottom: 22px; }
    .tt-ok .tt-row { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid #e5e7eb; }
    .tt-ok .tt-row span { color: #4b5563; }
    .tt-ok .tt-row b { text-align: right; }
    .tt-ok .tt-row b.tt-green { color: #1f8a5f; }
</style>

<div class="tt-ok card border-0 shadow-sm rounded-4 p-4">
    <div class="tt-icon"><i class="bi bi-check-lg"></i></div>
    <div class="tt-title">Thanh toán thành công!</div>
    <div class="tt-amount">@(soTien)đ</div>
    <div class="tt-time">@ViewBag.ThoiGian</div>

    <div class="tt-row"><span>Dịch vụ</span><b>Vé tháng @Model.SoThang tháng</b></div>
    <div class="tt-row"><span>Nhà cung cấp</span><b>ParkSmart</b></div>
    <div class="tt-row"><span>Nội dung</span><b>@ViewBag.NoiDung</b></div>
    <div class="tt-row"><span>Mã giao dịch</span><b class="tt-green">@ViewBag.MaGiaoDich</b></div>
    <div class="tt-row"><span>Số tiền</span><b>@(soTien)đ</b></div>
    <div class="tt-row"><span>Biển số xe</span><b>@Model.PhuongTien?.BienSoXe</b></div>
    <div class="tt-row"><span>Hiệu lực</span><b>@Model.NgayBatDau.ToString("dd/MM/yyyy") – @Model.NgayKetThuc.ToString("dd/MM/yyyy")</b></div>
    <div class="tt-row"><span>Phí dịch vụ</span><b>Miễn phí</b></div>

    <a asp-action="Index" class="btn btn-primary w-100 mt-4">Về danh sách vé tháng</a>
</div>
