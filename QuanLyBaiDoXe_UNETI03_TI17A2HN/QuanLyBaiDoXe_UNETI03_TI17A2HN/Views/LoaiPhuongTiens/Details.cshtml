@* Lương Thị Quỳnh Hương - 23103100064 *@
@model QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.LoaiPhuongTien

@{
    ViewData["Title"] = "Chi tiết Loại phương tiện";
}

<div class="container-fluid px-0" style="max-width: 900px;">
    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="card-header bg-primary text-white py-3 px-4 d-flex align-items-center gap-2">
            <i class="bi bi-info-circle fs-5"></i>
            <h5 class="m-0 fw-bold">Chi tiết Loại phương tiện: @Model.TenLoaiPhuongTien</h5>
        </div>

        <div class="card-body p-4 bg-white">
            <dl class="row mb-0 gy-3">
                <dt class="col-sm-3 text-secondary fw-semibold">
                    @Html.DisplayNameFor(model => model.TenLoaiPhuongTien):
                </dt>
                <dd class="col-sm-9 fw-bold text-dark fs-6 mb-0">
                    @Html.DisplayFor(model => model.TenLoaiPhuongTien)
                </dd>

                <dt class="col-sm-3 text-secondary fw-semibold">
                    @Html.DisplayNameFor(model => model.DonGiaTheoGio):
                </dt>
                <dd class="col-sm-9 fw-bold text-success fs-6 mb-0">
                    @Model.DonGiaTheoGio.ToString("N0") VNĐ/giờ
                </dd>

                <dt class="col-sm-3 text-secondary fw-semibold">
                    @Html.DisplayNameFor(model => model.TrangThai):
                </dt>
                <dd class="col-sm-9 mb-0">
                    @if (Model.TrangThai == true)
                    {
                        <span class="badge bg-success px-3 py-2 fw-normal" style="font-size: 13px;">
                            <i class="bi bi-check-circle-fill me-1"></i> Hoạt động
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary px-3 py-2 fw-normal" style="font-size: 13px;">
                            <i class="bi bi-slash-circle-fill me-1"></i> Ngừng áp dụng
                        </span>
                    }
                </dd>

                <dt class="col-sm-3 text-secondary fw-semibold">
                    @Html.DisplayNameFor(model => model.MoTa):
                </dt>
                <dd class="col-sm-9 text-dark mb-0">
                    @(string.IsNullOrEmpty(Model.MoTa) ? "Không có mô tả" : Model.MoTa)
                </dd>
            </dl>
        </div>

        <div class="card-footer bg-light px-4 py-3 d-flex justify-content-between align-items-center border-top">
            <a asp-action="Index" class="btn btn-secondary px-4 py-2 text-white fw-medium shadow-sm" style="background-color: #6c757d; border-color: #6c757d;">
                <i class="bi bi-arrow-left me-1"></i> Trở về danh sách
            </a>
            <a asp-action="Edit" asp-route-id="@Model?.MaLoaiPhuongTien" class="btn px-4 py-2 fw-medium shadow-sm text-dark" style="background-color: #ffc107; border-color: #ffc107;">
                <i class="bi bi-pencil-square me-1"></i> Sửa loại phương tiện này
            </a>
        </div>
    </div>
</div>
