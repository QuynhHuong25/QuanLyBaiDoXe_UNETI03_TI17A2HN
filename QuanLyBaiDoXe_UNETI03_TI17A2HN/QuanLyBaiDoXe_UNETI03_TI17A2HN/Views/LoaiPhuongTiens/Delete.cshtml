@* Lương Thị Quỳnh Hương - 23103100064 *@
@model QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.LoaiPhuongTien

@{
    ViewData["Title"] = "Xóa Loại phương tiện";
}

<div class="container-fluid px-0 d-flex justify-content-center">
    <div class="card shadow-sm border border-danger border-opacity-50 rounded-3 overflow-hidden" style="width: 100%; max-width: 650px;">
        <div class="card-header bg-danger text-white py-3 text-center">
            <h4 class="m-0 fw-bold">Cảnh báo: Xác nhận xóa loại phương tiện?</h4>
        </div>

        <div class="card-body p-4 bg-white">
            <p class="text-danger text-center fw-medium mb-4">
                Bạn có chắc chắn muốn xóa loại phương tiện này khỏi hệ thống không?
            </p>

            <dl class="row mb-0 gy-3">
                <dt class="col-sm-4 text-dark fw-bold">
                    Tên loại phương tiện:
                </dt>
                <dd class="col-sm-8 fw-semibold text-primary mb-0">
                    @Html.DisplayFor(model => model.TenLoaiPhuongTien)
                </dd>

                <dt class="col-sm-4 text-dark fw-bold">
                    Đơn giá theo giờ:
                </dt>
                <dd class="col-sm-8 fw-bold text-success mb-0">
                    @Model.DonGiaTheoGio.ToString("N0") VNĐ/giờ
                </dd>

                <dt class="col-sm-4 text-dark fw-bold">
                    Trạng thái:
                </dt>
                <dd class="col-sm-8 mb-0">
                    @if (Model.TrangThai == true)
                    {
                        <span class="badge bg-success px-3 py-1.5 fw-normal" style="border-radius: 6px;">
                            Hoạt động
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary px-3 py-1.5 fw-normal" style="border-radius: 6px;">
                            Ngừng áp dụng
                        </span>
                    }
                </dd>

                <dt class="col-sm-4 text-dark fw-bold">
                    Mô tả:
                </dt>
                <dd class="col-sm-8 text-secondary mb-0">
                    @(string.IsNullOrEmpty(Model.MoTa) ? "Không có mô tả" : Model.MoTa)
                </dd>
            </dl>

            <form asp-action="Delete" method="post" class="mt-4 pt-2">
                <input type="hidden" asp-for="MaLoaiPhuongTien" />

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-secondary px-4 py-2 text-white fw-medium shadow-sm" style="background-color: #6c757d; border-color: #6c757d;">
                        <i class="bi bi-arrow-left me-1"></i> Trở về danh sách
                    </a>

                    <button type="submit" class="btn btn-danger px-4 py-2 fw-medium shadow-sm d-inline-flex align-items-center gap-1" style="background-color: #dc3545; border-color: #dc3545;">
                        <i class="bi bi-trash"></i> Xác nhận xóa
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
