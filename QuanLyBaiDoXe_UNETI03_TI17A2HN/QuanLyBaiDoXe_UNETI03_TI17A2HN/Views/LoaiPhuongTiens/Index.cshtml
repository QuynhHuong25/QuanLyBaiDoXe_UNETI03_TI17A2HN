@* Lương Thị Quỳnh Hương - 23103100064 *@
@model IEnumerable<QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.LoaiPhuongTien>

@{
    ViewData["Title"] = "Danh sách Loại phương tiện";
}

<style>
    .table-container {
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(11,31,77,0.05);
        overflow: hidden;
        border: 1px solid #e2e8f0;
    }

    .custom-table {
        margin-bottom: 0;
        border-collapse: collapse;
        width: 100%;
    }

    /* Tiêu đề bảng hiện đại */
    .custom-table thead th {
        background-color: #f8fafc !important;
        color: #475569 !important;
        border-bottom: 2px solid #e2e8f0;
        border-top: none;
        padding: 14px 16px;
        font-weight: 700;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        vertical-align: middle;
    }

    /* Ô dữ liệu bảng */
    .custom-table tbody td {
        padding: 16px;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
        color: #1e293b;
        font-size: 14px;
    }

    /* Hiệu ứng dòng xen kẽ tinh tế */
    .custom-table tbody tr:nth-child(even) td {
        background-color: #fafbfc !important;
    }

    .custom-table tbody tr:hover td {
        background-color: #f1f5f9 !important;
    }

    /* Badge trạng thái chuẩn ParkSmart */
    .badge-status-active {
        background-color: #dcfce7;
        color: #166534;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 50px;
        font-size: 12.5px;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .badge-status-inactive {
        background-color: #f1f5f9;
        color: #64748b;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 50px;
        font-size: 12.5px;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    /* Cụm nút Thao tác dạng nhóm bo tròn liền viền giống mẫu */
    .action-group {
        display: inline-flex;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        overflow: hidden;
        background: #ffffff;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 34px;
        text-decoration: none;
        border-right: 1px solid #cbd5e1;
        transition: all 0.2s;
        font-size: 15px;
    }

    .action-btn:last-child {
        border-right: none;
    }

    .action-btn.view {
        color: #0ea5e9;
    }
    .action-btn.view:hover {
        background-color: #e0f2fe;
    }

    .action-btn.edit {
        color: #d97706;
    }
    .action-btn.edit:hover {
        background-color: #fef3c7;
    }

    .action-btn.delete {
        color: #ef4444;
    }
    .action-btn.delete:hover {
        background-color: #fee2e2;
    }
</style>

<div class="container-fluid px-0">
    <!-- Hiển thị thông báo TempData -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4 rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4 rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Page -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-dark fw-bold m-0 fs-3">Danh sách loại phương tiện</h2>
            <p class="text-secondary small mb-0 mt-1">Quản lý định mức và phân loại phương tiện gửi trong bãi</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-3 py-2 fw-semibold shadow-sm d-inline-flex align-items-center gap-2 rounded-3">
            <i class="bi bi-plus-circle"></i> Tạo mới loại xe
        </a>
    </div>

    <!-- Table Dữ Liệu -->
    <div class="table-container">
        <div class="table-responsive">
            <table class="table custom-table">
                <thead>
                    <tr>
                        <th style="width: 24%;">Tên loại phương tiện</th>
                        <th style="width: 18%;">Đơn giá theo giờ</th>
                        <th>Mô tả</th>
                        <th style="width: 15%; text-align: center;">Trạng thái</th>
                        <th style="width: 15%; text-align: center;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <!-- Tên loại phương tiện -->
                                <td>
                                    <span class="fw-bold text-dark">@item.TenLoaiPhuongTien</span>
                                </td>

                                <!-- Đơn giá -->
                                <td>
                                    <span class="fw-bold text-danger">@item.DonGiaTheoGio.ToString("N0") đ</span>
                                </td>

                                <!-- Mô tả -->
                                <td>
                                    <span class="text-secondary">@(string.IsNullOrEmpty(item.MoTa) ? "---" : item.MoTa)</span>
                                </td>

                                <!-- Trạng thái -->
                                <td class="text-center">
                                    <form asp-action="ToggleStatus" asp-route-id="@item.MaLoaiPhuongTien" method="post" class="d-inline">
                                        @if (item.TrangThai == true)
                                        {
                                            <button type="submit" class="badge-status-active" title="Bấm để đổi trạng thái">
                                                <i class="bi bi-check-circle"></i> Hoạt động
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="badge-status-inactive" title="Bấm để đổi trạng thái">
                                                <i class="bi bi-dash-circle"></i> Ngừng
                                            </button>
                                        }
                                    </form>
                                </td>

                                <!-- Thao tác nhóm icon chuẩn mẫu -->
                                <td class="text-center">
                                    <div class="action-group">
                                        <a asp-action="Details" asp-route-id="@item.MaLoaiPhuongTien" class="action-btn view" title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.MaLoaiPhuongTien" class="action-btn edit" title="Sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.MaLoaiPhuongTien" class="action-btn delete" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                Chưa có dữ liệu loại phương tiện nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
