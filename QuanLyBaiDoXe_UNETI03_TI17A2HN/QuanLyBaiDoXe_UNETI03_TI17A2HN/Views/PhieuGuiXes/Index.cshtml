@model IEnumerable<QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.PhieuGuiXe>

@{
    ViewData["Title"] = "Quản lý Phiếu gửi xe";
}

<h1>Danh sách Phiếu gửi xe</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Tạo mới</a>
</p>
<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>Biển số xe</th>
                <th>Vị trí đỗ</th>
                <th>Ngày đăng ký</th>
                <th>Dự kiến vào</th>
                <th>Dự kiến ra</th>
                <th>Vào thực tế</th>
                <th>Ra thực tế</th>
                <th>Đơn giá / giờ</th>
                <th>Thành tiền</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model) {
            <tr>
                <td>
                    @(item.PhuongTien != null ? item.PhuongTien.BienSoXe : item.MaPhuongTien.ToString())
                </td>
                <td>
                    @(item.ViTriDoXe != null ? item.ViTriDoXe.TenViTri : item.MaViTri.ToString())
                </td>
                <td>
                    @item.NgayDangKy.ToString("dd/MM/yyyy")
                </td>
                <td>
                    @item.ThoiGianDuKienVao.ToString("dd/MM/yyyy HH:mm")
                </td>
                <td>
                    @item.ThoiGianDuKienRa.ToString("dd/MM/yyyy HH:mm")
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ThoiGianVaoThucTe)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ThoiGianRaThucTe)
                </td>
                <td>
                    @item.DonGiaTheoGio.ToString("N0") VNĐ
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ThanhTien)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TrangThai)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-maphieu="@item.MaPhieu">Sửa</a> |
                    <a asp-action="Details" asp-route-maphieu="@item.MaPhieu">Chi tiết</a> |
                    <a asp-action="Delete" asp-route-maphieu="@item.MaPhieu">Xóa</a>
                </td>
            </tr>
}
        </tbody>
    </table>
</div>