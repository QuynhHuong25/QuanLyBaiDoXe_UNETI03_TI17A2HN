@model QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.PhieuGuiXe

@{
    ViewData["Title"] = "Đăng ký gửi xe";

    var danhSachXe =
        ViewBag.DanhSachXe as List<QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.PhuongTien>
        ?? new List<QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.PhuongTien>();

    var danhSachViTri =
        ViewBag.DanhSachViTri as List<QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.ViTriDoXe>
        ?? new List<QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.ViTriDoXe>();
}

@{
    var duLieuViTriJson = System.Text.Json.JsonSerializer.Serialize(
        danhSachViTri.Select(v => new
        {
            id = v.MaViTri,
            ten = v.TenViTri,
            loai = v.MaLoaiPhuongTien,
            tenLoai = v.LoaiPhuongTien?.TenLoaiPhuongTien,
            khu = v.KhuVuc,
            tang = v.Tang,
            tt = v.TrangThai
        }));
    var phieuGiuChoJson = System.Text.Json.JsonSerializer.Serialize(
        (ViewBag.PhieuGiuCho as List<object>) ?? new List<object>());
    int viTriDaChon = Model?.MaViTri ?? 0;
}

<style>
    .pick-wrap { border: 1px solid #e2e8f0; border-radius: 14px; background: #fff; padding: 16px; }
    .pick-tab { border-radius: 10px; padding: 6px 16px; font-weight: 700; font-size: 13px; border: 1px solid #e2e8f0; background: #fff; color: #1e293b; cursor: pointer; }
    .pick-tab.active { background: #0b1f4c; color: #fff; border-color: #0b1f4c; }
    .pick-gate { background: #0b1f4c; color: #fff; border-radius: 20px; padding: 8px 20px; font-weight: 700; font-size: 13px; }
    .pick-zone { border: 1px solid #e2e8f0; border-radius: 12px; padding: 12px; margin-bottom: 14px; }
    .pick-zone-title { font-weight: 700; font-size: 14px; }
    .pick-row { display: flex; align-items: center; gap: 10px; }
    .pick-row-label { min-width: 46px; text-align: center; font-size: 11px; font-weight: 800; color: #0b1f4c; background: #eef2ff; border: 1px solid #c7d2fe; border-radius: 8px; padding: 6px 4px; line-height: 1.3; }
    .pick-slots { display: flex; flex-wrap: wrap; gap: 8px; }
    .pick-aisle { background: #f1f5f9; color: #94a3b8; font-weight: 800; font-size: 11px; letter-spacing: 3px; text-align: center; padding: 4px 0; border-radius: 4px; margin: 10px 0; border: 1px dashed #cbd5e1; }
    .pick-slot { width: 68px; height: 82px; border-radius: 6px; padding: 4px 2px; display: flex; flex-direction: column; justify-content: space-between; align-items: center; border: 1px solid #cbd5e1; background: #fff; text-align: center; font-family: inherit; transition: all .15s; }
    .pick-slot .n { font-weight: 700; font-size: 11px; color: #475569; }
    .pick-slot .i { font-size: 20px; font-weight: 800; line-height: 1; }
    .pick-slot .b { font-size: 10px; font-weight: 700; }
    .pick-slot.free { background: #f0fdf4; border-color: #bbf7d0; cursor: pointer; }
    .pick-slot.free .i, .pick-slot.free .b { color: #16a34a; }
    .pick-slot.free:hover { transform: translateY(-2px); box-shadow: 0 4px 10px rgba(0,0,0,.1); }
    .pick-slot.busy { background: #fff5f5; border-color: #fca5a5; cursor: not-allowed; }
    .pick-slot.busy .i, .pick-slot.busy .b { color: #ef4444; }
    .pick-slot.off { background-color: #f1f5f9; cursor: not-allowed; background-image: repeating-linear-gradient(45deg, transparent, transparent 5px, rgba(203,213,225,.4) 5px, rgba(203,213,225,.4) 10px); }
    .pick-slot.off .i, .pick-slot.off .b { color: #94a3b8; }
    .pick-slot.selected { background: #2563eb; border-color: #1d4ed8; box-shadow: 0 0 0 3px rgba(37,99,235,.25); }
    .pick-slot.selected .n, .pick-slot.selected .i, .pick-slot.selected .b { color: #fff; }
    .pick-legend span { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: #64748b; margin-right: 14px; }
    .pick-legend i { width: 14px; height: 14px; border-radius: 3px; display: inline-block; border: 1px solid #cbd5e1; }
</style>

<div class="container py-4 py-lg-5">

    <!-- TIÊU ĐỀ -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-2">
                <i class="bi bi-car-front-fill text-primary me-2"></i>
                Đăng ký gửi xe
            </h2>
            <p class="text-secondary mb-0">
                Điền thông tin phương tiện và thời gian gửi xe.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Quay lại
        </a>
    </div>

    <!-- THÔNG BÁO -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- FORM ĐĂNG KÝ -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">

        <div class="card-header bg-primary text-white px-4 py-3">
            <h5 class="mb-1 fw-bold">
                <i class="bi bi-clipboard-check me-2"></i>
                Thông tin đăng ký
            </h5>
            <small class="text-white-50">
                Các trường có dấu <span class="text-warning">*</span> là bắt buộc.
            </small>
        </div>

        <div class="card-body p-3 p-md-4 p-lg-5">

            <form asp-action="Create"
                  method="post"
                  id="formDangKy">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>

                <!-- THÔNG TIN PHƯƠNG TIỆN -->
                <div class="mb-4">
                    <h6 class="fw-bold text-primary mb-3">
                        <i class="bi bi-car-front me-2"></i>
                        1. Thông tin phương tiện
                    </h6>

                    <div class="row g-3">

                        <div class="col-12">
                            <label asp-for="MaPhuongTien"
                                   class="form-label fw-semibold">
                                Phương tiện
                                <span class="text-danger">*</span>
                            </label>

                            @if (danhSachXe.Any())
                            {
                                <select asp-for="MaPhuongTien"
                                        class="form-select"
                                        id="MaPhuongTien"
                                        required>
                                    <option value="">-- Chọn phương tiện --</option>

                                    @foreach (var xe in danhSachXe)
                                    {
                                        <option value="@xe.MaPhuongTien"
                                                data-loai="@xe.MaLoaiPhuongTien"
                                                data-tenloai="@(xe.LoaiPhuongTien?.TenLoaiPhuongTien)">
                                            @xe.BienSoXe
                                            @if (xe.LoaiPhuongTien != null)
                                            {
                                                <text> - @xe.LoaiPhuongTien.TenLoaiPhuongTien</text>
                                            }
                                        </option>
                                    }
                                </select>

                                <span asp-validation-for="MaPhuongTien"
                                      class="text-danger small"></span>
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0">
                                    <i class="bi bi-exclamation-circle me-2"></i>
                                    Không có phương tiện để đăng ký.
                                    Vui lòng kiểm tra danh sách phương tiện.
                                </div>
                            }
                        </div>

                    </div>
                </div>

                <hr class="my-4" />

                <!-- THÔNG TIN VỊ TRÍ -->
                <div class="mb-4">
                    <h6 class="fw-bold text-primary mb-3">
                        <i class="bi bi-geo-alt-fill me-2"></i>
                        2. Vị trí đỗ xe
                    </h6>

                    <div class="row g-3">

                        <div class="col-12">
                            <label asp-for="MaViTri"
                                   class="form-label fw-semibold">
                                Vị trí đỗ
                                <span class="text-danger">*</span>
                            </label>

                            @if (danhSachViTri.Any())
                            {
                                <input type="hidden" asp-for="MaViTri" id="MaViTri" value="@(viTriDaChon > 0 ? viTriDaChon.ToString() : "")" />

                                <!-- Gợi ý khi chưa chọn phương tiện -->
                                <div id="pickHint" class="alert alert-secondary mb-0">
                                    <i class="bi bi-hand-index-thumb me-2"></i>
                                    Hãy chọn <b>phương tiện</b> ở bước 1 để xem sơ đồ vị trí đỗ phù hợp.
                                </div>

                                <!-- Bảng sơ đồ vị trí -->
                                <div id="pickWrap" class="pick-wrap d-none">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                        <div>
                                            <div class="fw-bold">Sơ đồ vị trí dành cho: <span id="pickLoai" class="text-primary"></span></div>
                                            <small class="text-secondary" id="pickThongKe"></small>
                                        </div>
                                        <div class="pick-legend">
                                            <span><i style="background:#f0fdf4;border-color:#bbf7d0"></i>Trống</span>
                                            <span><i style="background:#fff5f5;border-color:#fca5a5"></i>Đã có xe / trùng giờ</span>
                                            <span><i style="background:#e2e8f0"></i>Tạm ngừng</span>
                                            <span><i style="background:#2563eb;border-color:#1d4ed8"></i>Đang chọn</span>
                                        </div>
                                    </div>

                                    <div id="pickTabs" class="d-flex flex-wrap gap-2 mb-3"></div>
                                    <div id="pickMap"></div>
                                </div>

                                <div id="pickChon" class="mt-2 small d-none">
                                    <i class="bi bi-check-circle-fill text-success me-1"></i>
                                    Vị trí đã chọn: <b id="pickChonTen"></b>
                                </div>
                                <div id="pickLoi" class="text-danger small mt-2 d-none">Vui lòng chọn một vị trí đỗ trên sơ đồ.</div>

                                <span asp-validation-for="MaViTri"
                                      class="text-danger small"></span>

                                <div class="form-text">
                                    Sơ đồ chỉ hiển thị khu vực phù hợp với loại phương tiện bạn chọn.
                                    Ô đỏ là vị trí đã có xe hoặc trùng giờ gửi bạn đã nhập ở bước 3.
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0">
                                    <i class="bi bi-exclamation-circle me-2"></i>
                                    Hiện không có vị trí đỗ xe trong danh sách.
                                </div>
                            }
                        </div>

                    </div>
                </div>

                <hr class="my-4" />

                <!-- THỜI GIAN GỬI XE -->
                <div class="mb-4">
                    <h6 class="fw-bold text-primary mb-3">
                        <i class="bi bi-clock-history me-2"></i>
                        3. Thời gian gửi xe
                    </h6>

                    <div class="row g-3">

                        <div class="col-12 col-md-6">
                            <label asp-for="ThoiGianDuKienVao"
                                   class="form-label fw-semibold">
                                Thời gian dự kiến vào
                                <span class="text-danger">*</span>
                            </label>

                            <input asp-for="ThoiGianDuKienVao"
                                   type="datetime-local"
                                   class="form-control"
                                   id="ThoiGianDuKienVao"
                                   required
                                   step="60" />

                            <span asp-validation-for="ThoiGianDuKienVao"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="ThoiGianDuKienRa"
                                   class="form-label fw-semibold">
                                Thời gian dự kiến ra
                                <span class="text-danger">*</span>
                            </label>

                            <input asp-for="ThoiGianDuKienRa"
                                   type="datetime-local"
                                   class="form-control"
                                   id="ThoiGianDuKienRa"
                                   required
                                   step="60" />

                            <span asp-validation-for="ThoiGianDuKienRa"
                                  class="text-danger small"></span>
                        </div>

                    </div>

                    <div id="thongBaoThoiGian"
                         class="alert alert-danger mt-3 d-none"
                         role="alert">
                        Thời gian dự kiến ra phải sau thời gian dự kiến vào.
                    </div>
                </div>

                <!-- LƯU Ý -->
                <div class="alert alert-info border-0 rounded-3 mb-4">
                    <div class="d-flex align-items-start">
                        <i class="bi bi-info-circle-fill fs-5 me-3"></i>

                        <div>
                            <h6 class="fw-bold mb-2">Lưu ý khi đăng ký</h6>
                            <ul class="mb-0 ps-3">
                                <li>Phương tiện phải đang hoạt động.</li>
                                <li>Phương tiện phải thuộc tài khoản của bạn.</li>
                                <li>Một phương tiện không được có hai lượt gửi xe đang hoạt động.</li>
                                <li>Vị trí đỗ phải phù hợp với loại phương tiện.</li>
                                <li>Thời gian dự kiến ra phải sau thời gian dự kiến vào.</li>
                                <li>Vị trí đỗ không được trùng lịch với lượt gửi xe khác.</li>
                                <li>Đơn giá gửi xe cần được hệ thống xác định theo quy định hiện hành.</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- NÚT THAO TÁC -->
                <div class="d-flex flex-column-reverse flex-sm-row justify-content-end gap-2">

                    <a asp-action="Index"
                           class="btn btn-outline-secondary px-4">
                        <i class="bi bi-x-circle me-1"></i>
                        Hủy
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4"
                            id="btnDangKy"
                            disabled="@(!danhSachXe.Any() || !danhSachViTri.Any())">
                        <i class="bi bi-check-circle me-1"></i>
                        Đăng ký gửi xe
                    </button>

                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("formDangKy");
            const thoiGianVao = document.getElementById("ThoiGianDuKienVao");
            const thoiGianRa = document.getElementById("ThoiGianDuKienRa");
            const thongBao = document.getElementById("thongBaoThoiGian");

            if (!form || !thoiGianVao || !thoiGianRa) {
                return;
            }

            // Định dạng ngày theo múi giờ địa phương.
            function formatDateTimeLocal(date) {
                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, "0");
                const day = String(date.getDate()).padStart(2, "0");
                const hours = String(date.getHours()).padStart(2, "0");
                const minutes = String(date.getMinutes()).padStart(2, "0");

                return `${year}-${month}-${day}T${hours}:${minutes}`;
            }

            // Điền thời gian mặc định khi tạo đăng ký mới.
            if (!thoiGianVao.value) {
                const now = new Date();
                now.setSeconds(0, 0);
                thoiGianVao.value = formatDateTimeLocal(now);
            }

            if (!thoiGianRa.value && thoiGianVao.value) {
                const vao = new Date(thoiGianVao.value);

                if (!Number.isNaN(vao.getTime())) {
                    vao.setHours(vao.getHours() + 2);
                    thoiGianRa.value = formatDateTimeLocal(vao);
                }
            }

            // Kiểm tra thời gian và hiển thị thông báo.
            function kiemTraThoiGian(hienThongBao) {
                if (!thoiGianVao.value || !thoiGianRa.value) {
                    thongBao.classList.add("d-none");
                    return false;
                }

                const vao = new Date(thoiGianVao.value);
                const ra = new Date(thoiGianRa.value);

                const hopLe =
                    !Number.isNaN(vao.getTime()) &&
                    !Number.isNaN(ra.getTime()) &&
                    ra > vao;

                thongBao.classList.toggle("d-none", hopLe || !hienThongBao);

                thoiGianRa.setCustomValidity(
                    hopLe ? "" : "Thời gian ra phải sau thời gian vào."
                );

                return hopLe;
            }

            // Cập nhật thời gian ra nếu không còn sau thời gian vào.
            thoiGianVao.addEventListener("change", function () {
                if (!thoiGianVao.value) {
                    return;
                }

                const vao = new Date(thoiGianVao.value);
                const ra = new Date(thoiGianRa.value);

                if (Number.isNaN(vao.getTime())) {
                    return;
                }

                if (!thoiGianRa.value ||
                    Number.isNaN(ra.getTime()) ||
                    ra <= vao) {
                    const newRa = new Date(vao);
                    newRa.setHours(newRa.getHours() + 2);
                    thoiGianRa.value = formatDateTimeLocal(newRa);
                }

                kiemTraThoiGian(false);
            });

            thoiGianRa.addEventListener("change", function () {
                kiemTraThoiGian(true);
            });

            form.addEventListener("submit", function (event) {
                if (!kiemTraThoiGian(true)) {
                    event.preventDefault();
                    thoiGianRa.reportValidity();
                    thoiGianRa.focus();
                }
            });
        });
    </script>

    <script>
        // ===== SƠ ĐỒ CHỌN VỊ TRÍ ĐỖ =====
        (function () {
            const TANG_DANH_RIENG = 2; // Tầng 2 trở lên: ô tô / xe khách, chia theo hàng
            const viTris = @Html.Raw(duLieuViTriJson);
            const phieuGiuCho = @Html.Raw(phieuGiuChoJson);

            const selXe = document.getElementById("MaPhuongTien");
            const inpViTri = document.getElementById("MaViTri");
            const inpVao = document.getElementById("ThoiGianDuKienVao");
            const inpRa = document.getElementById("ThoiGianDuKienRa");
            const form = document.getElementById("formDangKy");
            if (!selXe || !inpViTri || !form) return;

            const elHint = document.getElementById("pickHint");
            const elWrap = document.getElementById("pickWrap");
            const elLoai = document.getElementById("pickLoai");
            const elThongKe = document.getElementById("pickThongKe");
            const elTabs = document.getElementById("pickTabs");
            const elMap = document.getElementById("pickMap");
            const elChon = document.getElementById("pickChon");
            const elChonTen = document.getElementById("pickChonTen");
            const elLoi = document.getElementById("pickLoi");

            let tangHienTai = null;

            const esc = (t) => String(t ?? "").replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
            const layHang = (ten) => { const i = (ten || "").indexOf("-"); return ((i > 0 ? ten.slice(0, i) : ten) || "").trim().toUpperCase(); };
            const loaiHienTai = () => { const o = selXe.options[selXe.selectedIndex]; return o && o.value ? parseInt(o.dataset.loai) : null; };
            const tenLoaiHienTai = () => { const o = selXe.options[selXe.selectedIndex]; return o ? (o.dataset.tenloai || "") : ""; };

            // Ô đang bận trong khoảng thời gian khách nhập (cùng quy tắc kiểm tra phía server)
            function laBan(maViTri) {
                const vao = inpVao && inpVao.value ? new Date(inpVao.value) : null;
                const ra = inpRa && inpRa.value ? new Date(inpRa.value) : null;
                const now = new Date();
                return phieuGiuCho.some(p => {
                    if (p.v !== maViTri) return false;
                    const a = new Date(p.a), b = new Date(p.b);
                    if (!vao || isNaN(vao)) return p.g;                  // chưa nhập giờ: chỉ khóa ô đang có xe
                    if (p.g && vao < (b > now ? b : now)) return true;  // xe đang đỗ chưa rời đi
                    if (ra && !isNaN(ra) && a < ra && b > vao) return true; // chồng lấn giờ
                    return false;
                });
            }

            function trangThaiO(v) {
                if (v.tt === "Tạm ngừng") return "off";
                if (laBan(v.id)) return "busy";
                return "free";
            }

            function oHtml(v) {
                const st = trangThaiO(v);
                const chon = String(v.id) === inpViTri.value && st === "free";
                const cls = chon ? "selected" : st;
                let icon = "P", nhan = "Trống";
                if (chon) { icon = "✓"; nhan = "Đã chọn"; }
                else if (st === "busy") { icon = "●"; nhan = "Có xe"; }
                else if (st === "off") { icon = "⊘"; nhan = "Ngừng"; }
                const dis = (st !== "free") ? "disabled" : "";
                return `<button type="button" class="pick-slot ${cls}" data-id="${v.id}" ${dis} title="${esc(v.ten)} - ${esc(v.khu)}">
                            <span class="n">${esc(v.ten)}</span><span class="i">${icon}</span><span class="b">${nhan}</span>
                        </button>`;
            }

            // Chia ô thành các dãy theo HÀNG trong tên vị trí (A1, A2...); các hàng cách nhau bằng lối đi
            function chiaDay(slots, khu, tang) {
                const m = new Map();
                slots.forEach(v => { const h = layHang(v.ten); if (!m.has(h)) m.set(h, []); m.get(h).push(v); });
                return [...m.keys()].sort().map(h => ({ ten: h, slots: m.get(h).sort((a, b) => a.ten.localeCompare(b.ten)) }));
            }

            function veSoDo() {
                const loai = loaiHienTai();
                if (!loai) {
                    elWrap.classList.add("d-none"); elHint.classList.remove("d-none");
                    inpViTri.value = ""; capNhatDaChon(); return;
                }
                const phuHop = viTris.filter(v => v.loai === loai);
                elHint.classList.add("d-none"); elWrap.classList.remove("d-none");
                elLoai.textContent = tenLoaiHienTai();

                if (phuHop.length === 0) {
                    elThongKe.textContent = "";
                    elTabs.innerHTML = "";
                    elMap.innerHTML = '<div class="alert alert-warning mb-0">Chưa có vị trí nào dành cho loại phương tiện này.</div>';
                    inpViTri.value = ""; capNhatDaChon(); return;
                }

                const trong = phuHop.filter(v => trangThaiO(v) === "free").length;
                elThongKe.textContent = `${trong} / ${phuHop.length} chỗ còn trống trong khung giờ đã chọn`;

                // Bỏ chọn nếu ô đã chọn không còn phù hợp / không còn trống
                const dangChon = viTris.find(v => String(v.id) === inpViTri.value);
                if (dangChon && (dangChon.loai !== loai || trangThaiO(dangChon) !== "free")) inpViTri.value = "";

                const cacTang = [...new Set(phuHop.map(v => v.tang))].sort((a, b) => a - b);
                if (tangHienTai === null || !cacTang.includes(tangHienTai)) {
                    const c = viTris.find(v => String(v.id) === inpViTri.value);
                    tangHienTai = c ? c.tang : cacTang[0];
                }

                elTabs.innerHTML = cacTang.map(t => {
                    const tr = phuHop.filter(v => v.tang === t && trangThaiO(v) === "free").length;
                    const tong = phuHop.filter(v => v.tang === t).length;
                    return `<button type="button" class="pick-tab ${t === tangHienTai ? "active" : ""}" data-tang="${t}">Tầng ${t} <span class="fw-normal opacity-75 ms-1">${tr}/${tong} trống</span></button>`;
                }).join("");

                const slotsTang = phuHop.filter(v => v.tang === tangHienTai);
                const khus = [...new Set(slotsTang.map(v => v.khu))].sort();
                let html = `<div class="pick-gate d-flex justify-content-between mb-3"><span>→ Cổng vào</span><span>Tầng ${tangHienTai}</span><span>Cổng ra →</span></div>`;
                khus.forEach(khu => {
                    const slotsKhu = slotsTang.filter(v => v.khu === khu);
                    const days = chiaDay(slotsKhu, khu, tangHienTai);
                    const theoHang = true;
                    html += `<div class="pick-zone"><div class="pick-zone-title mb-2">${esc(khu)} <small class="text-secondary fw-normal">· ${slotsKhu.length} chỗ</small></div>`;
                    days.forEach((d, i) => {
                        if (i > 0) html += `<div class="pick-aisle">L Ố I &nbsp; Đ I</div>`;
                        html += `<div class="pick-row">${theoHang ? `<div class="pick-row-label">Hàng<br>${esc(d.ten)}</div>` : ""}<div class="pick-slots">${d.slots.map(oHtml).join("")}</div></div>`;
                    });
                    html += `</div>`;
                });
                elMap.innerHTML = html;
                capNhatDaChon();
            }

            function capNhatDaChon() {
                const v = viTris.find(x => String(x.id) === inpViTri.value);
                if (v) { elChon.classList.remove("d-none"); elChonTen.textContent = `${v.ten} - ${v.khu} (Tầng ${v.tang})`; elLoi.classList.add("d-none"); }
                else { elChon.classList.add("d-none"); }
            }

            elMap.addEventListener("click", function (e) {
                const btn = e.target.closest(".pick-slot");
                if (!btn || btn.disabled) return;
                inpViTri.value = btn.dataset.id;
                veSoDo();
            });
            elTabs.addEventListener("click", function (e) {
                const btn = e.target.closest(".pick-tab");
                if (!btn) return;
                tangHienTai = parseInt(btn.dataset.tang);
                veSoDo();
            });

            selXe.addEventListener("change", function () { inpViTri.value = ""; tangHienTai = null; veSoDo(); });
            [inpVao, inpRa].forEach(i => i && i.addEventListener("change", veSoDo));

            form.addEventListener("submit", function (e) {
                if (!inpViTri.value) {
                    e.preventDefault();
                    elLoi.classList.remove("d-none");
                    (elWrap.classList.contains("d-none") ? selXe : elWrap).scrollIntoView({ behavior: "smooth", block: "center" });
                }
            });

            // Vẽ lần đầu (sau khi script thời gian mặc định đã điền giờ)
            document.addEventListener("DOMContentLoaded", function () { setTimeout(veSoDo, 0); });
        })();
    </script>
}
