
@model QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.PhieuGuiXe

@{
    ViewData["Title"] = "Chi tiết phiếu gửi xe";
}

<div class="container-fluid px-3 px-md-4 py-4">

    <!-- Tiêu đề -->
    <div class="mb-4">
        <h2 class="fw-bold text-dark">
            <i class="bi bi-card-list me-2"></i>
            Chi tiết phiếu gửi xe
        </h2>
        <p class="text-muted mb-0">
            Thông tin chi tiết đăng ký gửi xe.
        </p>
    </div>

    <!-- Thông tin phiếu gửi xe -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0">
                <i class="bi bi-info-circle me-2"></i>
                Thông tin phiếu gửi xe
            </h5>
        </div>

        <div class="card-body p-4">
            <div class="row g-4">

                <div class="col-md-6">
                    <label class="text-muted mb-1">Mã phiếu</label>
                    <div class="fw-bold">
                        @Model.MaPhieu
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted mb-1">Ngày đăng ký</label>
                    <div class="fw-semibold">
                        @Model.NgayDangKy.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted mb-1">Mã phương tiện</label>
                    <div class="fw-semibold">
                        @Model.MaPhuongTien
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted mb-1">Mã vị trí đỗ</label>
                    <div class="fw-semibold">
                        @Model.MaViTri
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted mb-1">Trạng thái phiếu</label>
                    <div>
                        @if (Model.TrangThai == "Chờ xác nhận")
                        {
                            <span class="badge bg-warning text-dark px-3 py-2">
                                Chờ xác nhận
                            </span>
                        }
                        else if (Model.TrangThai == "Đang gửi")
                        {
                            <span class="badge bg-primary px-3 py-2">
                                Đang gửi
                            </span>
                        }
                        else if (Model.TrangThai == "Đã lấy xe")
                        {
                            <span class="badge bg-success px-3 py-2">
                                Đã lấy xe
                            </span>
                        }
                        else if (Model.TrangThai == "Đã hủy")
                        {
                            <span class="badge bg-danger px-3 py-2">
                                Đã hủy
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary px-3 py-2">
                                @(Model.TrangThai ?? "Chưa xác định")
                            </span>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Thời gian gửi xe -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0 text-primary">
                <i class="bi bi-clock-history me-2"></i>
                Thời gian gửi xe
            </h5>
        </div>

        <div class="card-body p-4">
            <div class="row g-4">

                <div class="col-md-6">
                    <label class="text-muted mb-1">
                        Thời gian dự kiến vào
                    </label>
                    <div class="fw-semibold">
                        @Model.ThoiGianDuKienVao.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted mb-1">
                        Thời gian dự kiến ra
                    </label>
                    <div class="fw-semibold">
                        @Model.ThoiGianDuKienRa.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted mb-1">
                        Thời gian vào thực tế
                    </label>
                    <div class="fw-semibold">
                        @if (Model.ThoiGianVaoThucTe.HasValue)
                        {
                            @Model.ThoiGianVaoThucTe.Value.ToString("dd/MM/yyyy HH:mm")
                        }
                        else
                        {
                            <span class="text-muted">Chưa vào bãi</span>
                        }
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted mb-1">
                        Thời gian ra thực tế
                    </label>
                    <div class="fw-semibold">
                        @if (Model.ThoiGianRaThucTe.HasValue)
                        {
                            @Model.ThoiGianRaThucTe.Value.ToString("dd/MM/yyyy HH:mm")
                        }
                        else
                        {
                            <span class="text-muted">Chưa lấy xe</span>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Chi phí -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0 text-primary">
                <i class="bi bi-cash-coin me-2"></i>
                Thông tin thanh toán
            </h5>
        </div>

        <div class="card-body p-4">
            <div class="row g-4">

                <div class="col-md-6">
                    <label class="text-muted mb-1">
                        Đơn giá theo giờ
                    </label>
                    <div class="fw-semibold">
                        @Model.DonGiaTheoGio.ToString("N0") VNĐ/giờ
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted mb-1">
                        Thành tiền
                    </label>
                    <div class="fw-bold text-danger fs-5">
                        @if (Model.ThanhTien.HasValue)
                        {
                            @Model.ThanhTien.Value.ToString("N0")
                            <span>VNĐ</span>
                        }
                        else
                        {
                            <span class="text-muted fs-6 fw-normal">
                                Chưa tính phí
                            </span>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Nút thao tác -->
    <div class="d-flex flex-wrap gap-2 mb-4">

        <a asp-action="Edit"
               asp-route-id="@Model.MaPhieu"
               class="btn btn-warning">
            <i class="bi bi-pencil-square me-1"></i>
            Chỉnh sửa
        </a>

        <a asp-action="Index"
               class="btn btn-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Quay lại danh sách
        </a>

    </div>

</div>
```
