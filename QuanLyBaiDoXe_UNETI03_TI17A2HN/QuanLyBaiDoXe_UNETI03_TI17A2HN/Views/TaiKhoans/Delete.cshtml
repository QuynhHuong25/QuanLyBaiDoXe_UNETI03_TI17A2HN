@* Lương Thị Quỳnh Hương - 23103100064 *@
@model QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.TaiKhoan

@{
    ViewData["Title"] = "Xóa tài khoản";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-danger fw-bold m-0 fs-3">Xác nhận xóa tài khoản</h2>
            <p class="text-secondary small mb-0 mt-1">Bạn có chắc chắn muốn xóa vĩnh viễn tài khoản này khỏi hệ thống không?</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary px-3 py-2 fw-semibold rounded-3">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 p-4 bg-white" style="max-width: 600px;">
        <div class="mb-3">
            <h5 class="fw-bold text-dark mb-3">Thông tin tài khoản cần xóa:</h5>
            <dl class="row mb-0">
                <dt class="col-sm-4 text-secondary">Tên đăng nhập:</dt>
                <dd class="col-sm-8 fw-semibold text-dark">@Model.TenDangNhap</dd>

                <dt class="col-sm-4 text-secondary">Họ tên:</dt>
                <dd class="col-sm-8 fw-semibold text-dark">@Model.HoTen</dd>

                <dt class="col-sm-4 text-secondary">Email:</dt>
                <dd class="col-sm-8 text-secondary">@Model.Email</dd>

                <dt class="col-sm-4 text-secondary">Vai trò:</dt>
                <dd class="col-sm-8">
                    <span class="badge bg-primary bg-opacity-10 text-primary px-2 py-1 rounded-pill">@Model.VaiTro</span>
                </dd>

                <dt class="col-sm-4 text-secondary">Trạng thái:</dt>
                <dd class="col-sm-8">
                    @if (Model.TrangThai == true)
                    {
                        <span class="badge bg-success bg-opacity-10 text-success px-2 py-1 rounded-pill">Hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-danger bg-opacity-10 text-danger px-2 py-1 rounded-pill">Khóa</span>
                    }
                </dd>
            </dl>
        </div>

        <form asp-action="Delete" method="post" class="mt-4 pt-3 border-top d-flex gap-2">
            <input type="hidden" asp-for="MaTaiKhoan" />
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger px-4 py-2 fw-semibold rounded-3">
                <i class="bi bi-trash-fill me-1"></i> Xác nhận xóa
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 fw-semibold rounded-3">Hủy bỏ</a>
        </form>
    </div>
</div>
