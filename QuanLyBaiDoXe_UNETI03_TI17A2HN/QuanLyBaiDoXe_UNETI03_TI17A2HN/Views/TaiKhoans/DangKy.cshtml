@* Lương Thị Quỳnh Hương - 23103100064 *@
@{
    Layout = null;
    ViewData["Title"] = "Đăng ký tài khoản";
}<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng ký - Hệ thống quản lý bãi đỗ xe</title>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <style>
        :root {
            --nv: #0b1f4d;       /* Xanh Navy chủ đạo */
            --pr: #1e40af;       /* Royal Blue */
            --ac: #f5b400;       /* Vàng Gold Amber */
            --ac-hover: #e0a300;
            --tx: #0f172a;       /* Chữ đen than */
            --mu: #64748b;       /* Chữ mờ */
            --bd: #e2e8f0;       /* Viền thẻ */
        }

        body {
            background-color: var(--nv);
            background-image: radial-gradient(800px 400px at 85% 15%, rgba(37,99,235,0.35), transparent),
                              linear-gradient(135deg, #0b1f4d 0%, #071536 100%);
            font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            -webkit-font-smoothing: antialiased;
        }

        .login-card {
            background: transparent;
            border: none;
            max-width: 1160px;
            width: 100%;
        }

        .login-left {
            padding: 40px 32px 40px 10px;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 22px;
            font-weight: 800;
            color: #fff;
            text-decoration: none;
            margin-bottom: 24px;
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: var(--ac);
            color: var(--nv);
            display: grid;
            place-items: center;
            font-weight: 800;
            font-size: 20px;
        }

        .hero-heading {
            font-size: clamp(28px, 3.2vw, 40px);
            font-weight: 800;
            line-height: 1.25;
            letter-spacing: -0.5px;
            margin-bottom: 12px;
            color: #fff;
        }

        .hero-sub {
            color: #cbd5e1;
            font-size: 14.5px;
            font-weight: 500;
            margin-bottom: 24px;
        }

        .banner-img-container {
            width: 100%;
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 30px;
            box-shadow: 0 16px 36px rgba(0,0,0,0.25);
        }
        .banner-img-container img {
            width: 100%;
            height: auto;
            display: block;
        }

        .features-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
        }
        .feature-box {
            display: flex;
            gap: 10px;
            align-items: flex-start;
        }
        .feature-box i {
            font-size: 20px;
            color: var(--ac);
            margin-top: 2px;
        }
        .feature-box h6 {
            font-size: 13.5px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 2px;
        }
        .feature-box p {
            font-size: 11.5px;
            color: #94a3b8;
            margin: 0;
            line-height: 1.4;
        }

        .login-right-card {
            background: #ffffff;
            border-radius: 24px;
            padding: 44px 40px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.2);
            color: var(--tx);
        }

        .right-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 20px;
            font-weight: 800;
            color: var(--nv);
            margin-bottom: 4px;
        }

        .right-desc {
            color: var(--mu);
            font-size: 13.5px;
            margin-bottom: 28px;
        }

        .form-label-custom {
            font-size: 13px;
            font-weight: 700;
            color: var(--tx);
            margin-bottom: 6px;
        }
        .form-label-custom span {
            color: #dc2626;
        }

        .form-control-custom {
            height: 48px;
            border-radius: 12px;
            border: 1px solid var(--bd);
            padding-left: 42px;
            font-size: 14px;
            background-color: #ffffff;
            color: var(--tx);
            transition: all .2s;
        }
        .form-control-custom:focus {
            border-color: var(--pr);
            box-shadow: 0 0 0 3px rgba(30,64,175,0.12);
            background-color: #ffffff;
        }

        .input-icon-wrapper {
            position: relative;
        }
        .input-icon-wrapper i.input-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--mu);
            font-size: 1.1rem;
        }
        .input-icon-wrapper i.toggle-password {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--mu);
            cursor: pointer;
            font-size: 1.1rem;
        }

        .btn-register-gold {
            height: 48px;
            background-color: var(--ac);
            border: none;
            border-radius: 12px;
            font-weight: 700;
            font-size: 15px;
            color: var(--nv);
            transition: all .2s;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(245,180,0,0.3);
        }
        .btn-register-gold:hover {
            background-color: var(--ac-hover);
            box-shadow: 0 6px 18px rgba(245,180,0,0.4);
            transform: translateY(-1px);
        }

        .btn-outline-custom {
            height: 48px;
            border-radius: 12px;
            border: 1.5px solid var(--bd);
            color: var(--pr);
            font-weight: 700;
            font-size: 14px;
            background: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            text-decoration: none;
            transition: all .2s;
        }
        .btn-outline-custom:hover {
            background: rgba(30,64,175,0.04);
            border-color: var(--pr);
            color: var(--pr);
        }

        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            color: var(--mu);
            font-size: 13px;
            margin: 22px 0;
        }
        .divider::before, .divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid var(--bd);
        }
        .divider span {
            padding: 0 12px;
        }

        /* Sử dụng @@media để tránh lỗi biên dịch Razor */
        @@media (max-width: 991px) {
            .login-left { display: none !important; }
            body { padding: 16px; }
        }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="row align-items-center g-0">

            <!-- CỘT TRÁI: BANNER ĐỒ HỌA & TÍNH NĂNG -->
            <div class="col-lg-7 login-left d-none d-lg-flex">
                <div>
                    <a class="logo" asp-controller="Home" asp-action="Index">
                        <div class="logo-icon">P</div>
                        <span>ParkSmart</span>
                    </a>
                    <h1 class="hero-heading">
                        Tạo tài khoản mới<br />trải nghiệm gửi xe thông minh
                    </h1>
                    <p class="hero-sub">Nhanh chóng &nbsp;•&nbsp; An toàn &nbsp;•&nbsp; Tiện lợi</p>
                </div>

                <div class="banner-img-container">
                    <img src="~/css/Image/BaiDoXe.png" alt="Bãi đỗ xe thông minh" />
                </div>

                <div class="features-row">
                    <div class="feature-box">
                        <i class="bi bi-shield-check"></i>
                        <div>
                            <h6>An toàn</h6>
                            <p>Bảo mật thông tin người dùng</p>
                        </div>
                    </div>
                    <div class="feature-box">
                        <i class="bi bi-lightning-charge"></i>
                        <div>
                            <h6>Nhanh chóng</h6>
                            <p>Thủ tục đơn giản, tiết kiệm thời gian</p>
                        </div>
                    </div>
                    <div class="feature-box">
                        <i class="bi bi-heart"></i>
                        <div>
                            <h6>Tiện lợi</h6>
                            <p>Đăng ký và quản lý mọi lúc, mọi nơi</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI: FORM ĐĂNG KÝ -->
            <div class="col-lg-5">
                <div class="login-right-card">
                    
                    <div class="right-brand mb-1">
                        <div class="logo-icon" style="width: 34px; height: 34px; font-size: 16px;">P</div>
                        <span>ParkSmart</span>
                    </div>
                    <p class="right-desc">Điền đầy đủ thông tin để đăng ký tài khoản</p>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger py-2 small rounded-3 mb-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewBag.Error
                        </div>
                    }

                    <form asp-controller="TaiKhoans" asp-action="DangKy" method="post">

                        <div class="mb-3">
                            <label class="form-label-custom">Tên đăng nhập <span>*</span></label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-person input-icon"></i>
                                <input type="text" 
                                       name="tenDangNhap" 
                                       class="form-control form-control-custom" 
                                       placeholder="Nhập tên đăng nhập" 
                                       required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label-custom">Mật khẩu <span>*</span></label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-lock input-icon"></i>
                                <input type="password" 
                                       id="passwordInput" 
                                       name="matKhau" 
                                       class="form-control form-control-custom" 
                                       placeholder="Nhập mật khẩu" 
                                       required />
                                <i class="bi bi-eye-slash toggle-password" onclick="togglePasswordVisibility('passwordInput', this)"></i>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label-custom">Xác nhận mật khẩu <span>*</span></label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-shield-lock input-icon"></i>
                                <input type="password" 
                                       id="confirmPasswordInput" 
                                       name="xacNhanMatKhau" 
                                       class="form-control form-control-custom" 
                                       placeholder="Nhập lại mật khẩu" 
                                       required />
                                <i class="bi bi-eye-slash toggle-password" onclick="togglePasswordVisibility('confirmPasswordInput', this)"></i>
                            </div>
                        </div>

                        <button type="submit" class="btn-register-gold">
                            <span>Đăng ký tài khoản</span>
                            <i class="bi bi-arrow-right"></i>
                        </button>
                    </form>

                    <div class="divider">
                        <span>Hoặc</span>
                    </div>

                    <a asp-controller="TaiKhoans" asp-action="DangNhap" class="btn-outline-custom w-100">
                        <i class="bi bi-box-arrow-in-right text-primary"></i>
                        <span>Đã có tài khoản? Đăng nhập</span>
                    </a>

                    <div class="text-center mt-4">
                        <small class="text-muted" style="font-size: 11.5px;">&copy; 2026 ParkSmart. Tất cả quyền được bảo lưu.</small>
                    </div>

                </div>
            </div>

        </div>
    </div>

    <script>
        function togglePasswordVisibility(inputId, toggleIcon) {
            const input = document.getElementById(inputId);
            if (input.type === 'password') {
                input.type = 'text';
                toggleIcon.classList.remove('bi-eye-slash');
                toggleIcon.classList.add('bi-eye');
            } else {
                input.type = 'password';
                toggleIcon.classList.remove('bi-eye');
                toggleIcon.classList.add('bi-eye-slash');
            }
        }
    </script>
</body>
</html>
