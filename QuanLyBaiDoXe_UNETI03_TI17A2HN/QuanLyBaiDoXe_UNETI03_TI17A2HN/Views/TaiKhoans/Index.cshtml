@* Lương Thị Quỳnh Hương - 23103100064 *@
@model IEnumerable<QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.TaiKhoan>

@{
    ViewData["Title"] = "Danh sách tài khoản";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string? currentSearch = ViewBag.CurrentSearch as string;
}

<style>
    .table-container {
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(11,31,77,0.05);
        overflow: hidden;
        border: 1px solid #e2e8f0;
    }

    .custom-table {
        margin-bottom: 0;
        border-collapse: collapse;
        width: 100%;
    }

    .custom-table thead th {
        background-color: #f8fafc !important;
        color: #475569 !important;
        border-bottom: 2px solid #e2e8f0;
        border-top: none;
        padding: 14px 16px;
        font-weight: 700;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        vertical-align: middle;
    }

    .custom-table tbody td {
        padding: 16px;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
        color: #1e293b;
        font-size: 14px;
    }

    .custom-table tbody tr:nth-child(even) td {
        background-color: #fafbfc !important;
    }

    .custom-table tbody tr:hover td {
        background-color: #f1f5f9 !important;
    }

    /* Cụm nút thao tác nhóm ô vuông chuẩn mẫu ParkSmart */
    .action-group {
        display: inline-flex;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        overflow: hidden;
        background: #ffffff;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 34px;
        text-decoration: none;
        border-right: 1px solid #cbd5e1;
        transition: all 0.2s;
        font-size: 15px;
    }

    .action-btn:last-child {
        border-right: none;
    }

    .action-btn.view { color: #0ea5e9; }
    .action-btn.view:hover { background-color: #e0f2fe; }

    .action-btn.edit { color: #d97706; }
    .action-btn.edit:hover { background-color: #fef3c7; }

    .action-btn.delete { color: #ef4444; }
    .action-btn.delete:hover { background-color: #fee2e2; }

    /* CSS tinh chỉnh giao diện phân trang rời từng nút bo tròn giống mẫu */
    .custom-pagination .pagination {
        gap: 6px;
    }

    .custom-pagination .page-item .page-link {
        border: 1px solid #e2e8f0;
        border-radius: 8px !important;
        color: #475569;
        padding: 8px 14px;
        font-weight: 600;
        font-size: 14px;
        background-color: #ffffff;
        transition: all 0.2s;
    }

    .custom-pagination .page-item .page-link:hover {
        background-color: #f1f5f9;
        color: #1e293b;
        border-color: #cbd5e1;
    }

    .custom-pagination .page-item.active .page-link {
        background-color: #2563eb !important;
        border-color: #2563eb !important;
        color: #ffffff !important;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
    }

    .custom-pagination .page-item.disabled .page-link {
        background-color: #f8fafc;
        color: #94a3b8;
        border-color: #e2e8f0;
    }
</style>

<div class="container-fluid px-0">
    <!-- Hiển thị thông báo TempData -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4 rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4 rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Page -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-dark fw-bold m-0 fs-3">Danh sách tài khoản</h2>
            <p class="text-secondary small mb-0 mt-1">Quản lý quyền truy cập hệ thống và thông tin tài khoản người dùng</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-3 py-2 fw-semibold shadow-sm d-inline-flex align-items-center gap-2 rounded-3">
            <i class="bi bi-plus-circle"></i> Tạo mới tài khoản
        </a>
    </div>

    <!-- Table Dữ Liệu -->
    <div class="table-container">
        <div class="table-responsive">
            <table class="table custom-table">
                <thead>
                    <tr>
                        <th>Tên đăng nhập</th>
                        <th>Mật khẩu</th>
                        <th>Họ tên</th>
                        <th>Email</th>
                        <th class="text-center">Vai trò</th>
                        <th class="text-center">Trạng thái</th>
                        <th>Chủ phương tiện</th>
                        <th style="width: 130px; text-align: center;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="fw-bold text-dark">@Html.DisplayFor(modelItem => item.TenDangNhap)</span>
                                </td>
                                <td>
                                    <span class="text-muted" style="letter-spacing: 2px;">••••••••</span>
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">@Html.DisplayFor(modelItem => item.HoTen)</span>
                                </td>
                                <td>
                                    <span class="text-secondary">@Html.DisplayFor(modelItem => item.Email)</span>
                                </td>
                                <td class="text-center">
                                    @if (item.VaiTro == "Admin")
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-semibold">Admin</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-2 rounded-pill fw-semibold">@item.VaiTro</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.TrangThai == true || item.TrangThai.ToString() == "True" || item.TrangThai.ToString() == "1")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fw-semibold">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill fw-semibold">Khóa</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-secondary">@(item.ChuPhuongTien != null ? item.ChuPhuongTien.HoTen : "---")</span>
                                </td>
                                <td class="text-center">
                                    <div class="action-group">
                                        <a asp-action="Details" asp-route-mataikhoan="@item.MaTaiKhoan" class="action-btn view" title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-mataikhoan="@item.MaTaiKhoan" class="action-btn edit" title="Sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-mataikhoan="@item.MaTaiKhoan" class="action-btn delete" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                Chưa có dữ liệu tài khoản nào trong hệ thống.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Phân trang chuẩn mẫu bo tròn -->
    @if (totalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-4 custom-pagination">
            <ul class="pagination justify-content-center mb-0">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(currentPage - 1)"
                       asp-route-searchString="@currentSearch">Trước</a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(currentPage == i ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-searchString="@currentSearch">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(currentPage + 1)"
                       asp-route-searchString="@currentSearch">Sau</a>
                </li>
            </ul>
        </nav>
    }
</div>
