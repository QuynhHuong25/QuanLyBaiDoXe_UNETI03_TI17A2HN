@model QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.PhuongTien

@{
    ViewData["Title"] = "Xóa phương tiện";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold text-danger">
            <i class="bi bi-trash me-2"></i>
            Xóa phương tiện
        </h2>
        <p class="text-muted">
            Kiểm tra thông tin trước khi thực hiện xóa.
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">
                <i class="bi bi-exclamation-triangle me-2"></i>
                Xác nhận xóa
            </h5>
        </div>

        <div class="card-body">
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                Bạn có chắc chắn muốn xóa phương tiện này không?
                <br />
                Hành động này không thể hoàn tác.
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="text-muted">
                        Mã phương tiện
                    </label>
                    <div class="fw-semibold">
                        @Model.MaPhuongTien
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted">
                        Biển số xe
                    </label>
                    <div class="fw-bold fs-5">
                        @Model.BienSoXe
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted">
                        Chủ phương tiện
                    </label>
                    <div>
                        @(Model.ChuPhuongTien?.HoTen ?? "Chưa xác định")
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted">
                        Loại phương tiện
                    </label>
                    <div>
                        @(Model.LoaiPhuongTien?.TenLoaiPhuongTien ?? "Chưa xác định")
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted">
                        Nhãn hiệu
                    </label>
                    <div>
                        @(string.IsNullOrWhiteSpace(Model.NhanHieu)
                            ? "Chưa cập nhật"
                            : Model.NhanHieu)
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted">
                        Màu sắc
                    </label>
                    <div>
                        @(string.IsNullOrWhiteSpace(Model.MauSac)
                            ? "Chưa cập nhật"
                            : Model.MauSac)
                    </div>
                </div>

                <div class="col-12">
                    <label class="text-muted">
                        Trạng thái
                    </label>
                    <div>
                        @if (Model.TrangThai)
                        {
                            <span class="badge bg-success fs-6">
                                Hoạt động
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6">
                                Ngừng hoạt động
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer bg-white">
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MaPhuongTien" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>
                        Xác nhận xóa
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i>
                        Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>

</div>