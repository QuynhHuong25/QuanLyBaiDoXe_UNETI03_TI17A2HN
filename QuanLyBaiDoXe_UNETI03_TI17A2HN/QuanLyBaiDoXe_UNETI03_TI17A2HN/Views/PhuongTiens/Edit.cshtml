@model QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.PhuongTien

@{
    ViewData["Title"] = "Sửa phương tiện";
}

<div class="container py-4">

    <!-- TIÊU ĐỀ -->
    <div class="mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-pencil-square me-2"></i>
            Sửa phương tiện
        </h2>
        <p class="text-muted mb-0">
            Cập nhật thông tin và trạng thái phương tiện.
        </p>
    </div>

    <!-- FORM -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <!-- ID -->
                <input type="hidden" asp-for="MaPhuongTien" />

                <!-- VALIDATION -->
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- CHỦ PHƯƠNG TIỆN -->
                <div class="mb-3">
                    <label asp-for="MaChuPhuongTien" class="form-label fw-semibold">
                        Chủ phương tiện
                    </label>
                    <select asp-for="MaChuPhuongTien"
                            asp-items="ViewBag.MaChuPhuongTien"
                            class="form-select">
                        <option value="">-- Chọn chủ phương tiện --</option>
                    </select>
                    <span asp-validation-for="MaChuPhuongTien" class="text-danger"></span>
                </div>

                <!-- LOẠI PHƯƠNG TIỆN -->
                <div class="mb-3">
                    <label asp-for="MaLoaiPhuongTien" class="form-label fw-semibold">
                        Loại phương tiện
                        <span class="text-danger">*</span>
                    </label>
                    <select asp-for="MaLoaiPhuongTien"
                            asp-items="ViewBag.MaLoaiPhuongTien"
                            class="form-select">
                        <option value="">-- Chọn loại phương tiện --</option>
                    </select>
                    <span asp-validation-for="MaLoaiPhuongTien" class="text-danger"></span>
                </div>

                <div class="row">
                    <!-- BIỂN SỐ -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="BienSoXe" class="form-label fw-semibold">
                            Biển số xe
                            <span class="text-danger">*</span>
                        </label>
                        <input asp-for="BienSoXe"
                               class="form-control"
                               autocomplete="off"
                               placeholder="Ví dụ: 29A-12345" />
                        <span asp-validation-for="BienSoXe" class="text-danger"></span>
                    </div>

                    <!-- NHÃN HIỆU -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="NhanHieu" class="form-label fw-semibold">
                            Nhãn hiệu
                        </label>
                        <input asp-for="NhanHieu"
                               class="form-control"
                               placeholder="Ví dụ: Honda, Toyota..." />
                        <span asp-validation-for="NhanHieu" class="text-danger"></span>
                    </div>
                </div>

                <!-- MÀU SẮC -->
                <div class="mb-3">
                    <label asp-for="MauSac" class="form-label fw-semibold">
                        Màu sắc
                    </label>
                    <input asp-for="MauSac"
                           class="form-control"
                           placeholder="Ví dụ: Đen, Trắng, Đỏ..." />
                    <span asp-validation-for="MauSac" class="text-danger"></span>
                </div>

                <!-- ẢNH PHƯƠNG TIỆN -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Ảnh phương tiện</label>
                    @if (!string.IsNullOrEmpty(Model.HinhAnh))
                    {
                        <div class="mb-2">
                            <img src="@Model.HinhAnh" alt="Ảnh hiện tại" class="rounded border" style="max-height:160px;max-width:100%" />
                            <div class="form-check mt-1">
                                <input class="form-check-input" type="checkbox" name="xoaAnh" value="true" id="xoaAnh" />
                                <label class="form-check-label small" for="xoaAnh">Xóa ảnh hiện tại</label>
                            </div>
                        </div>
                    }
                    <input type="file" name="fileAnh" id="fileAnh" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                    <div class="form-text">Chọn ảnh mới để thay thế. JPG, PNG hoặc WEBP, tối đa 3 MB.</div>
                    <span asp-validation-for="HinhAnh" class="text-danger"></span>
                    <img id="xemTruocAnh" alt="Xem trước ảnh" class="mt-2 rounded border d-none" style="max-height:180px;max-width:100%" />
                </div>

                <!-- MÔ TẢ -->
                <div class="mb-3">
                    <label asp-for="MoTa" class="form-label fw-semibold">
                        Mô tả
                    </label>
                    <textarea asp-for="MoTa"
                              class="form-control"
                              rows="4"
                              placeholder="Nhập mô tả phương tiện..."></textarea>
                    <span asp-validation-for="MoTa" class="text-danger"></span>
                </div>

                <!-- TRẠNG THÁI -->
                <div class="mb-4">
                    <label asp-for="TrangThai" class="form-label fw-semibold">
                        Trạng thái
                        <span class="text-danger">*</span>
                    </label>
                    <select asp-for="TrangThai" class="form-select">
                        <option value="true">Hoạt động</option>
                        <option value="false">Ngừng hoạt động</option>
                    </select>
                    <span asp-validation-for="TrangThai" class="text-danger"></span>
                    <div class="form-text">
                        <i class="bi bi-info-circle me-1"></i>
                        Xe đang gửi trong bãi không thể chuyển sang trạng thái Ngừng hoạt động.
                    </div>
                </div>

                <!-- BUTTON -->
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>
                        Lưu thay đổi
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i>
                        Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Xem trước ảnh ngay khi chọn file
        document.getElementById('fileAnh')?.addEventListener('change', function () {
            var img = document.getElementById('xemTruocAnh');
            var f = this.files && this.files[0];
            if (!f) { img.classList.add('d-none'); return; }
            if (f.size > 3 * 1024 * 1024) { alert('Ảnh vượt quá 3 MB, vui lòng chọn ảnh nhỏ hơn.'); this.value = ''; img.classList.add('d-none'); return; }
            img.src = URL.createObjectURL(f);
            img.classList.remove('d-none');
        });
    </script>
}
