@* Lương Thị Quỳnh Hương - 23103100064 *@
@model IEnumerable<QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.PhuongTien>

@{
    ViewData["Title"] = "Quản lý phương tiện";

    string vaiTro = ViewBag.UserRole as string ?? "";
    var listDangGui = ViewBag.ListDangGui as IEnumerable<int> ?? Enumerable.Empty<int>();

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int total = ViewBag.Total ?? 0;

    bool isAdmin = vaiTro == "Admin";
    string currentBienSo = ViewBag.CurrentBienSo as string ?? "";
    string currentChuXe = ViewBag.CurrentChuXe as string ?? "";
    string currentNhanHieu = ViewBag.CurrentNhanHieu as string ?? "";
    string currentTrangThai = ViewBag.CurrentTrangThai as string ?? "";
    var dsNhanHieu = ViewBag.NhanHieuList as List<string> ?? new List<string>();
}

<style>
    .table-container {
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(11,31,77,0.05);
        overflow: hidden;
        border: 1px solid #e2e8f0;
    }

    .custom-table {
        margin-bottom: 0;
        border-collapse: collapse;
        width: 100%;
    }

        .custom-table thead th {
            background-color: #f8fafc !important;
            color: #475569 !important;
            border-bottom: 2px solid #e2e8f0;
            border-top: none;
            padding: 14px 16px;
            font-weight: 700;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            vertical-align: middle;
        }

        .custom-table tbody td {
            padding: 16px;
            vertical-align: middle;
            border-bottom: 1px solid #f1f5f9;
            color: #1e293b;
            font-size: 14px;
        }

        .custom-table tbody tr:nth-child(even) td {
            background-color: #fafbfc !important;
        }

        .custom-table tbody tr:hover td {
            background-color: #f1f5f9 !important;
        }

    /* Cụm nút thao tác nhóm ô vuông chuẩn mẫu ParkSmart */
    .action-group {
        display: inline-flex;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        overflow: hidden;
        background: #ffffff;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 34px;
        text-decoration: none;
        border: none;
        border-right: 1px solid #cbd5e1;
        background: transparent;
        transition: all 0.2s;
        font-size: 15px;
        cursor: pointer;
    }

        .action-btn:last-child {
            border-right: none;
        }

        .action-btn.view {
            color: #0ea5e9;
        }

            .action-btn.view:hover {
                background-color: #e0f2fe;
            }

        .action-btn.edit {
            color: #d97706;
        }

            .action-btn.edit:hover {
                background-color: #fef3c7;
            }

        .action-btn.delete {
            color: #ef4444;
        }

            .action-btn.delete:hover {
                background-color: #fee2e2;
            }

        .action-btn.disabled-btn {
            color: #94a3b8;
            background-color: #f8fafc;
            cursor: not-allowed;
        }

    /* CSS tùy chỉnh phân trang bo tròn */
    .custom-pagination .pagination {
        gap: 6px;
    }

    .custom-pagination .page-item .page-link {
        border: 1px solid #e2e8f0;
        border-radius: 8px !important;
        color: #475569;
        padding: 8px 14px;
        font-weight: 600;
        font-size: 14px;
        background-color: #ffffff;
        transition: all 0.2s;
    }

        .custom-pagination .page-item .page-link:hover {
            background-color: #f1f5f9;
            color: #1e293b;
            border-color: #cbd5e1;
        }

    .custom-pagination .page-item.active .page-link {
        background-color: #2563eb !important;
        border-color: #2563eb !important;
        color: #ffffff !important;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
    }

    .custom-pagination .page-item.disabled .page-link {
        background-color: #f8fafc;
        color: #94a3b8;
        border-color: #e2e8f0;
    }
</style>

<div class="container-fluid p-0">

    <!-- Tiêu đề (giống trang Vị trí đỗ xe) -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Danh sách Phương tiện</h2>
        <div>
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Tạo mới</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4 rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4 rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Khung tìm kiếm & lọc (giống trang Vị trí đỗ xe) -->
    <div class="card shadow-sm mb-4">
        <div class="card-body bg-light">
            <form asp-action="Index" method="get">
                <div class="row g-2">
                    <!-- Biển số xe -->
                    <div class="@(isAdmin ? "col-md-3" : "col-md-4")">
                        <label class="form-label font-weight-bold">Biển số xe:</label>
                        <input type="text"
                               name="searchBienSo"
                               value="@currentBienSo"
                               class="form-control"
                               placeholder="Nhập biển số xe..." />
                    </div>

                    <!-- Chủ phương tiện (chỉ Admin) -->
                    @if (isAdmin)
                    {
                        <div class="col-md-3">
                            <label class="form-label font-weight-bold">Chủ phương tiện:</label>
                            <input type="text"
                                   name="searchChuXe"
                                   value="@currentChuXe"
                                   class="form-control"
                                   placeholder="Nhập tên chủ phương tiện..." />
                        </div>
                    }

                    <!-- Nhãn hiệu -->
                    <div class="@(isAdmin ? "col-md-3" : "col-md-4")">
                        <label class="form-label font-weight-bold">Nhãn hiệu:</label>
                        <select name="nhanHieu" class="form-select">
                            <option value="">-- Tất cả --</option>
                            @foreach (var nh in dsNhanHieu)
                            {
                                <option value="@nh" selected="@(currentNhanHieu == nh)">@nh</option>
                            }
                        </select>
                    </div>

                    <!-- Trạng thái -->
                    <div class="@(isAdmin ? "col-md-3" : "col-md-4")">
                        <label class="form-label font-weight-bold">Trạng thái:</label>
                        <select name="trangThai" class="form-select">
                            <option value="">-- Tất cả --</option>
                            <option value="hoatDong" selected="@(currentTrangThai == "hoatDong")">Hoạt động</option>
                            <option value="dangGui" selected="@(currentTrangThai == "dangGui")">Đang gửi</option>
                            <option value="ngungHoatDong" selected="@(currentTrangThai == "ngungHoatDong")">Ngừng hoạt động</option>
                        </select>
                    </div>

                    <div class="col-md-12 text-end mt-3">
                        <button type="submit" class="btn btn-success me-1"><i class="bi bi-funnel"></i> Tìm/Lọc</button>
                        <a asp-action="Index" class="btn btn-secondary">Đặt lại</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="mb-3 text-secondary small">
        Tổng số: <strong class="text-dark">@total</strong> phương tiện
    </div>

    <!-- Bảng dữ liệu -->
    <div class="table-container">
        <div class="table-responsive">
            <table class="table custom-table">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 70px;">STT</th>
                        <th>Biển số xe</th>
                        <th>Chủ phương tiện</th>
                        <th>Loại phương tiện</th>
                        <th>Nhãn hiệu</th>
                        <th>Màu sắc</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center" style="width: 140px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int stt = (currentPage - 1) * 10 + 1;

                        foreach (var item in Model)
                        {
                            bool dangGui = listDangGui.Contains(item.MaPhuongTien);

                            <tr>
                                <td class="text-center text-secondary">@stt</td>
                                <td>
                                    <span class="fw-bold text-dark">@item.BienSoXe</span>
                                </td>
                                <td><span class="text-secondary">@(item.ChuPhuongTien?.HoTen ?? "---")</span></td>
                                <td><span class="text-secondary">@(item.LoaiPhuongTien?.TenLoaiPhuongTien ?? "---")</span></td>
                                <td>
                                    <span class="text-secondary">@(string.IsNullOrWhiteSpace(item.NhanHieu) ? "---" : item.NhanHieu)</span>
                                </td>
                                <td>
                                    <span class="text-secondary">@(string.IsNullOrWhiteSpace(item.MauSac) ? "---" : item.MauSac)</span>
                                </td>
                                <td class="text-center">
                                    @if (dangGui)
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill fw-semibold">
                                            <i class="bi bi-car-front-fill me-1"></i> Đang gửi
                                        </span>
                                    }
                                    else if (item.TrangThai)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fw-semibold">
                                            <i class="bi bi-check-circle me-1"></i> Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-2 rounded-pill fw-semibold">
                                            <i class="bi bi-x-circle me-1"></i> Ngừng HĐ
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="action-group">
                                        <a asp-action="Details"
                                           asp-route-id="@item.MaPhuongTien"
                                           class="action-btn view"
                                           title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit"
                                           asp-route-id="@item.MaPhuongTien"
                                           class="action-btn edit"
                                           title="Sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (!dangGui)
                                        {
                                            <a asp-action="Delete"
                                               asp-route-id="@item.MaPhuongTien"
                                               class="action-btn delete"
                                               title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="action-btn disabled-btn" title="Xe đang gửi, không thể xóa">
                                                <i class="bi bi-lock"></i>
                                            </span>
                                        }
                                    </div>
                                </td>
                            </tr>
                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                Không tìm thấy phương tiện nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Phân trang (giữ nguyên bộ lọc khi chuyển trang) -->
    @if (totalPages > 1)
    {
        <nav class="mt-4 custom-pagination">
            <ul class="pagination justify-content-center mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(currentPage - 1)"
                       asp-route-searchBienSo="@currentBienSo"
                       asp-route-searchChuXe="@currentChuXe"
                       asp-route-nhanHieu="@currentNhanHieu"
                       asp-route-trangThai="@currentTrangThai">
                        <i class="bi bi-chevron-left"></i> Trước
                    </a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-searchBienSo="@currentBienSo"
                           asp-route-searchChuXe="@currentChuXe"
                           asp-route-nhanHieu="@currentNhanHieu"
                           asp-route-trangThai="@currentTrangThai">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(currentPage + 1)"
                       asp-route-searchBienSo="@currentBienSo"
                       asp-route-searchChuXe="@currentChuXe"
                       asp-route-nhanHieu="@currentNhanHieu"
                       asp-route-trangThai="@currentTrangThai">
                        Sau <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>
