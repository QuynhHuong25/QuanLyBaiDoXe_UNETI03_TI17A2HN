@model QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.PhuongTien

@{
    ViewData["Title"] = "Chi tiết phương tiện";

    var listDangGui = ViewBag.ListDangGui as IEnumerable<int>
                      ?? Enumerable.Empty<int>();

    bool dangGui = listDangGui.Contains(Model.MaPhuongTien);
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-car-front-fill me-2"></i>
            Chi tiết phương tiện
        </h2>
        <p class="text-muted">
            Thông tin chi tiết của phương tiện.
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-info-circle me-2"></i>
                Thông tin phương tiện
            </h5>
        </div>

        <div class="card-body">
            <div class="row g-4">

                <!-- MÃ PHƯƠNG TIỆN -->
                <div class="col-md-6">
                    <label class="text-muted">
                        Mã phương tiện
                    </label>
                    <div class="fw-semibold fs-5">
                        @Model.MaPhuongTien
                    </div>
                </div>

                <!-- BIỂN SỐ -->
                <div class="col-md-6">
                    <label class="text-muted">
                        Biển số xe
                    </label>
                    <div class="fw-bold fs-5">
                        @Model.BienSoXe
                    </div>
                </div>

                <!-- CHỦ PHƯƠNG TIỆN -->
                <div class="col-md-6">
                    <label class="text-muted">
                        Chủ phương tiện
                    </label>
                    <div class="fw-semibold">
                        @(Model.ChuPhuongTien?.HoTen ?? "Chưa xác định")
                    </div>
                </div>

                <!-- LOẠI -->
                <div class="col-md-6">
                    <label class="text-muted">
                        Loại phương tiện
                    </label>
                    <div class="fw-semibold">
                        @(Model.LoaiPhuongTien?.TenLoaiPhuongTien ?? "Chưa xác định")
                    </div>
                </div>

                <!-- NHÃN HIỆU -->
                <div class="col-md-6">
                    <label class="text-muted">
                        Nhãn hiệu
                    </label>
                    <div>
                        @(string.IsNullOrWhiteSpace(Model.NhanHieu)
                            ? "Chưa cập nhật"
                            : Model.NhanHieu)
                    </div>
                </div>

                <!-- MÀU SẮC -->
                <div class="col-md-6">
                    <label class="text-muted">
                        Màu sắc
                    </label>
                    <div>
                        @(string.IsNullOrWhiteSpace(Model.MauSac)
                            ? "Chưa cập nhật"
                            : Model.MauSac)
                    </div>
                </div>

                <!-- TRẠNG THÁI -->
                <div class="col-md-6">
                    <label class="text-muted">
                        Trạng thái phương tiện
                    </label>
                    <div class="mt-1">
                        @if (Model.TrangThai)
                        {
                            <span class="badge bg-success fs-6">
                                <i class="bi bi-check-circle me-1"></i>
                                Hoạt động
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6">
                                <i class="bi bi-x-circle me-1"></i>
                                Ngừng hoạt động
                            </span>
                        }
                    </div>
                </div>

                <!-- TRẠNG THÁI GỬI XE -->
                <div class="col-md-6">
                    <label class="text-muted">
                        Trạng thái gửi xe
                    </label>
                    <div class="mt-1">
                        @if (dangGui)
                        {
                            <span class="badge bg-warning text-dark fs-6">
                                <i class="bi bi-car-front-fill me-1"></i>
                                Đang gửi
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-light text-dark border fs-6">
                                <i class="bi bi-p-square me-1"></i>
                                Không gửi trong bãi
                            </span>
                        }
                    </div>
                </div>

                <!-- MÔ TẢ -->
                <div class="col-12">
                    <label class="text-muted">
                        Mô tả
                    </label>
                    <div class="border rounded p-3 bg-light mt-1">
                        @if (string.IsNullOrWhiteSpace(Model.MoTa))
                        {
                            <span class="text-muted">
                                Chưa có mô tả.
                            </span>
                        }
                        else
                        {
                            @Model.MoTa
                        }
                    </div>
                </div>

            </div>
        </div>

        <!-- FOOTER -->
        <div class="card-footer bg-white">
            <div class="d-flex gap-2">
                <a asp-action="Edit"
                       asp-route-id="@Model.MaPhuongTien"
                       class="btn btn-warning">
                    <i class="bi bi-pencil me-1"></i>
                    Chỉnh sửa
                </a>
                <a asp-action="Index"
                       class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Quay lại
                </a>
            </div>
        </div>
    </div>

</div>
