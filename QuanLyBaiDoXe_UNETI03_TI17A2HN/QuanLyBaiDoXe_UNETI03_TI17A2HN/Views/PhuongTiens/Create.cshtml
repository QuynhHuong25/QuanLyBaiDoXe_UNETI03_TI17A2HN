@model QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.PhuongTien

@{
    ViewData["Title"] = "Thêm phương tiện";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-plus-circle me-2"></i>
            Thêm phương tiện
        </h2>
        <p class="text-muted">
            Nhập thông tin phương tiện cần thêm vào hệ thống.
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- CHỦ PHƯƠNG TIỆN -->
                <div class="mb-3">
                    <label asp-for="MaChuPhuongTien" class="form-label fw-semibold">
                        Chủ phương tiện
                        <span class="text-danger">*</span>
                    </label>
                    <select asp-for="MaChuPhuongTien"
                            asp-items="ViewBag.MaChuPhuongTien"
                            class="form-select">
                        <option value="">-- Chọn chủ phương tiện --</option>
                    </select>
                    <span asp-validation-for="MaChuPhuongTien" class="text-danger"></span>
                </div>

                <!-- LOẠI PHƯƠNG TIỆN -->
                <div class="mb-3">
                    <label asp-for="MaLoaiPhuongTien" class="form-label fw-semibold">
                        Loại phương tiện
                        <span class="text-danger">*</span>
                    </label>
                    <select asp-for="MaLoaiPhuongTien"
                            asp-items="ViewBag.MaLoaiPhuongTien"
                            class="form-select">
                        <option value="">-- Chọn loại phương tiện --</option>
                    </select>
                    <span asp-validation-for="MaLoaiPhuongTien" class="text-danger"></span>
                </div>

                <div class="row">
                    <!-- BIỂN SỐ -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="BienSoXe" class="form-label fw-semibold">
                            Biển số xe
                            <span class="text-danger">*</span>
                        </label>
                        <input asp-for="BienSoXe"
                               class="form-control"
                               placeholder="Ví dụ: 29A-12345"
                               autocomplete="off" />
                        <span asp-validation-for="BienSoXe" class="text-danger"></span>
                    </div>

                    <!-- NHÃN HIỆU -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="NhanHieu" class="form-label fw-semibold">
                            Nhãn hiệu
                        </label>
                        <input asp-for="NhanHieu"
                               class="form-control"
                               placeholder="Ví dụ: Honda, Toyota..." />
                        <span asp-validation-for="NhanHieu" class="text-danger"></span>
                    </div>
                </div>

                <!-- MÀU SẮC -->
                <div class="mb-3">
                    <label asp-for="MauSac" class="form-label fw-semibold">
                        Màu sắc
                    </label>
                    <input asp-for="MauSac"
                           class="form-control"
                           placeholder="Ví dụ: Đen, Trắng, Đỏ..." />
                    <span asp-validation-for="MauSac" class="text-danger"></span>
                </div>

                <!-- MÔ TẢ -->
                <div class="mb-3">
                    <label asp-for="MoTa" class="form-label fw-semibold">
                        Mô tả
                    </label>
                    <textarea asp-for="MoTa"
                              class="form-control"
                              rows="4"
                              placeholder="Nhập mô tả phương tiện nếu có..."></textarea>
                    <span asp-validation-for="MoTa" class="text-danger"></span>
                </div>

                <!-- TRẠNG THÁI -->
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    Phương tiện mới sẽ được tạo với trạng thái <strong>Hoạt động</strong>.
                </div>

                <!-- BUTTON -->
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle me-1"></i>
                        Thêm phương tiện
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-1"></i>
                        Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}