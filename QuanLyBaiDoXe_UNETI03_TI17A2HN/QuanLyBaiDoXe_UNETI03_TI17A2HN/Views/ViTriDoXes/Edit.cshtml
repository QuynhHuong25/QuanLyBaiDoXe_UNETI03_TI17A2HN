@model QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.ViTriDoXe

@{
    ViewData["Title"] = "Cập nhật Vị trí đỗ xe";
    bool isDangSuDung = Model.TrangThai == "Đang sử dụng";
}

<div class="row justify-content-center mt-3">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-warning text-dark text-center py-3 rounded-top-4">
                <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Cập nhật Vị trí đỗ xe</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" id="formEditViTri">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="MaViTri" />

                    <div class="form-group mb-3">
                        <label asp-for="TenViTri" class="form-label fw-semibold">Tên vị trí (*)</label>
                        <input asp-for="TenViTri" class="form-control rounded-3" required placeholder="Ví dụ: A1-01, B2-05..." />
                        <span asp-validation-for="TenViTri" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="MaLoaiPhuongTien" class="form-label fw-semibold">Loại phương tiện (*)</label>
                        <select asp-for="MaLoaiPhuongTien" class="form-select rounded-3" asp-items="ViewBag.MaLoaiPhuongTien"></select>
                        <span asp-validation-for="MaLoaiPhuongTien" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="KhuVuc" class="form-label fw-semibold">Khu vực (*)</label>
                        <input asp-for="KhuVuc" class="form-control rounded-3" required placeholder="Ví dụ: Khu A, Khu B..." />
                        <span asp-validation-for="KhuVuc" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Tang" class="form-label fw-semibold">Tầng (*)</label>
                        <input asp-for="Tang" type="number" class="form-control rounded-3" min="1" required />
                        <span asp-validation-for="Tang" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="TrangThai" class="form-label fw-semibold">Trạng thái (*)</label>
                        @if (isDangSuDung)
                        {
                            <!-- Nếu vị trí đang có xe đỗ, giữ cố định giá trị và khóa ô chọn -->
                            <input type="hidden" asp-for="TrangThai" value="Đang sử dụng" />
                            <select class="form-select rounded-3 bg-light text-danger fw-bold" disabled>
                                <option selected>Đang sử dụng (Có xe đỗ - Không thể đổi)</option>
                            </select>
                            <small class="text-muted mt-1 d-block"><i class="bi bi-info-circle me-1"></i>Vị trí này đang có xe đỗ. Trạng thái sẽ tự chuyển về "Còn trống" khi xe ra khỏi bãi.</small>
                        }
                        else
                        {
                            <!-- Nếu ô rảnh: Chỉ cho phép chuyển giữa "Còn trống" và "Tạm ngừng" -->
                            <select asp-for="TrangThai" class="form-select rounded-3">
                                <option value="Còn trống">Còn trống</option>
                                <option value="Tạm ngừng">Tạm ngừng (Bảo trì/Sự cố)</option>
                            </select>
                        }
                        <span asp-validation-for="TrangThai" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="MoTa" class="form-label fw-semibold">Mô tả</label>
                        <textarea asp-for="MoTa" class="form-control rounded-3" rows="3" placeholder="Ghi chú hoặc mô tả thêm..."></textarea>
                        <span asp-validation-for="MoTa" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between pt-2">
                        <a asp-action="Index" class="btn btn-secondary px-3 rounded-3 fw-semibold">
                            <i class="bi bi-arrow-left me-1"></i> Trở về danh sách
                        </a>
                        <button type="submit" class="btn btn-warning px-4 rounded-3 fw-bold text-dark">
                            <i class="bi bi-check-lg me-1"></i> Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
