@model QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.ViTriDoXe

@{
    var phieuDict = ViewData["PhieuDict"] as Dictionary<int, string> ?? new Dictionary<int, string>();
    bool isAdmin = ViewData["IsAdmin"] as bool? ?? false;

    string plate = phieuDict.ContainsKey(Model.MaViTri) ? phieuDict[Model.MaViTri] : "";
    bool isOccupied = Model.TrangThai == "Đang sử dụng";
    bool isDisabled = Model.TrangThai == "Tạm ngừng";

    string statusClass = "empty";
    if (isOccupied) { statusClass = "occupied"; }
    else if (isDisabled) { statusClass = "disabled"; }
}

@if (isAdmin)
{
    @if (isOccupied)
    {
        <!-- NẾU ĐANG CÓ XE ĐỖ: Bấm vào cảnh báo không thể tạm ngừng -->
        <div class="slot-box @statusClass"
             title="@Model.TenViTri - Đang có xe đỗ (@plate)"
             onclick="alert('Không thể tạm ngừng vị trí @Model.TenViTri vì hiện đang có xe đỗ!');">
            <span class="slot-name">@Model.TenViTri</span>
            <div class="slot-icon-text">
                <i class="bi bi-pin-map-fill"></i>
            </div>
            <div class="slot-badge-plate" title="@plate">
                @(string.IsNullOrEmpty(plate) ? "Có xe" : plate)
            </div>
        </div>
    }
    else
    {
        <!-- NẾU TRỐNG HOẶC TẠM NGỪNG: Click trực tiếp để TOGGLE BẬT/TẮT TẠM NGỪNG NHANH -->
        <form asp-controller="ViTriDoXes" asp-action="ToggleTamNgung" asp-route-id="@Model.MaViTri" method="post" class="d-inline" id="form-toggle-@Model.MaViTri">
            @Html.AntiForgeryToken()

            @if (isDisabled)
            {
                <!-- Bấm vào ô Tạm ngừng -> Chuyển về Còn trống -->
                <div class="slot-box @statusClass"
                     title="Đang tạm ngừng - Nhấn để mở lại"
                     onclick="if(confirm('Mở lại hoạt động cho vị trí @Model.TenViTri?')) document.getElementById('form-toggle-@Model.MaViTri').submit();">
                    <span class="slot-name">@Model.TenViTri</span>
                    <div class="slot-icon-text">
                        <i class="bi bi-slash-circle text-secondary"></i>
                    </div>
                    <span class="slot-badge text-success fw-bold" style="font-size: 10px;">
                        <i class="bi bi-play-circle-fill me-1"></i>Mở lại
                    </span>
                </div>
            }
            else
            {
                <!-- Bấm vào ô Trống -> Chuyển sang Tạm ngừng -->
                <div class="slot-box @statusClass"
                     title="Đang trống - Nhấn để tạm ngừng vị trí này"
                     onclick="if(confirm('Xác nhận TẠM NGỪNG vị trí @Model.TenViTri?')) document.getElementById('form-toggle-@Model.MaViTri').submit();">
                    <span class="slot-name">@Model.TenViTri</span>
                    <div class="slot-icon-text">P</div>
                    <span class="slot-badge">Trống</span>
                </div>
            }
        </form>
    }
}
else
{
    <!-- HIỂN THỊ DÀNH CHO KHÁCH HÀNG (Chỉ xem, không click được) -->
    <div class="slot-box @statusClass" title="@Model.TenViTri - Trạng thái: @Model.TrangThai">
        <span class="slot-name">@Model.TenViTri</span>

        @if (isOccupied)
        {
            <div class="slot-icon-text">
                <i class="bi bi-pin-map-fill"></i>
            </div>
            <div class="slot-badge-plate" title="@plate">
                @(string.IsNullOrEmpty(plate) ? "Có xe" : plate)
            </div>
        }
        else if (isDisabled)
        {
            <div class="slot-icon-text">
                <i class="bi bi-slash-circle"></i>
            </div>
            <span class="slot-badge">Ngừng</span>
        }
        else
        {
            <div class="slot-icon-text">P</div>
            <span class="slot-badge">Trống</span>
        }
    </div>
}
