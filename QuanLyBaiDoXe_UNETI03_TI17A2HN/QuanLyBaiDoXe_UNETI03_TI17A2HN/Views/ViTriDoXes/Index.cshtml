@* Lương Thị Quỳnh Hương - 23103100064 *@
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@model IEnumerable<QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.ViTriDoXe>

@{
    ViewData["Title"] = "Quản lý Vị trí đỗ xe";
    var vaiTro = HttpContextAccessor.HttpContext?.Session.GetString("VaiTro");
    bool isAdmin = !string.IsNullOrEmpty(vaiTro) &&
                  (vaiTro.Equals("Admin", StringComparison.OrdinalIgnoreCase));

    var currentSort = ViewData["CurrentSort"]?.ToString();
    var currentTrangThai = ViewData["CurrentTrangThai"]?.ToString();

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
    var soDo = ViewBag.SoDo as List<QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.ViTriDoXe>
            ?? new List<QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.ViTriDoXe>();
}

<style>
    /* BẢNG DỮ LIỆU & NÚT THAO TÁC */
    .table-container {
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(11,31,77,0.05);
        overflow: hidden;
        border: 1px solid #e2e8f0;
    }

    .custom-table {
        margin-bottom: 0;
        border-collapse: collapse;
        width: 100%;
    }

        .custom-table thead th {
            background-color: #f8fafc !important;
            color: #475569 !important;
            border-bottom: 2px solid #e2e8f0;
            border-top: none;
            padding: 14px 16px;
            font-weight: 700;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            vertical-align: middle;
        }

        .custom-table tbody td {
            padding: 16px;
            vertical-align: middle;
            border-bottom: 1px solid #f1f5f9;
            color: #1e293b;
            font-size: 14px;
        }

        .custom-table tbody tr:nth-child(even) td {
            background-color: #fafbfc !important;
        }

        .custom-table tbody tr:hover td {
            background-color: #f1f5f9 !important;
        }

    .action-group {
        display: inline-flex;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        overflow: hidden;
        background: #ffffff;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 34px;
        text-decoration: none;
        border-right: 1px solid #cbd5e1;
        transition: all 0.2s;
        font-size: 15px;
        background: none;
        border-top: none;
        border-bottom: none;
        border-left: none;
        cursor: pointer;
    }

        .action-btn:last-child {
            border-right: none;
        }

        .action-btn.view {
            color: #0ea5e9;
        }

            .action-btn.view:hover {
                background-color: #e0f2fe;
            }

        .action-btn.edit {
            color: #d97706;
        }

            .action-btn.edit:hover {
                background-color: #fef3c7;
            }

        .action-btn.delete {
            color: #ef4444;
        }

            .action-btn.delete:hover {
                background-color: #fee2e2;
            }

        .action-btn.toggle-btn {
            color: #64748b;
        }

            .action-btn.toggle-btn:hover {
                background-color: #f1f5f9;
            }

    /* KHUNG SƠ ĐỒ ĐỖ XE */
    .parking-header-bar {
        background-color: #0b1f4c;
        color: #ffffff;
        border-radius: 8px;
        padding: 10px 20px;
        font-weight: 600;
    }

    .zone-card {
        border-radius: 14px;
        border: 1px solid #e2e8f0;
        background-color: #ffffff;
        box-shadow: 0 2px 8px rgba(0,0,0,0.03);
        height: 100%;
    }

        .zone-card.zone-a {
            border-top: 5px solid #2563eb;
        }

        .zone-card.zone-b {
            border-top: 5px solid #10b981;
        }

        .zone-card.zone-c {
            border-top: 5px solid #8b5cf6;
        }

        .zone-card.zone-d {
            border-top: 5px solid #0284c7;
        }

    .zone-icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 15px;
        color: white;
        flex-shrink: 0;
    }

    .zone-a .zone-icon {
        background-color: #2563eb;
    }

    .zone-b .zone-icon {
        background-color: #10b981;
    }

    .zone-c .zone-icon {
        background-color: #8b5cf6;
    }

    .zone-d .zone-icon {
        background-color: #0284c7;
    }

    /* THẺ Ô ĐỖ THIẾT KẾ GỌN GÀNG */
    .slot-box {
        width: 65px;
        height: 75px;
        border-radius: 8px;
        text-align: center;
        padding: 4px 2px;
        font-size: 11px;
        position: relative;
        cursor: pointer;
        transition: all 0.15s ease-in-out;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        border: 1px solid transparent;
        text-decoration: none !important;
    }

        .slot-box:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.08);
        }

        /* TRẠNG THÁI Ô ĐỖ */
        .slot-box.empty {
            background-color: #f0fdf4;
            border-color: #dcfce7;
            color: #166534;
        }

            .slot-box.empty .slot-name {
                color: #15803d;
            }

            .slot-box.empty .slot-icon-text {
                color: #22c55e;
                font-weight: 800;
                font-size: 16px;
            }

            .slot-box.empty .slot-badge {
                color: #16a34a;
                font-weight: 600;
            }

        .slot-box.occupied {
            background-color: #fef2f2;
            border-color: #fee2e2;
            color: #991b1b;
        }

            .slot-box.occupied .slot-name {
                color: #b91c1c;
            }

            .slot-box.occupied .slot-icon-text {
                color: #ef4444;
                font-size: 16px;
            }

            .slot-box.occupied .slot-badge {
                background-color: #ef4444;
                color: white;
                font-weight: 700;
                border-radius: 3px;
                padding: 1px 2px;
                width: 100%;
            }

        .slot-box.disabled {
            background-color: #f8fafc;
            border-color: #e2e8f0;
            color: #94a3b8;
        }

            .slot-box.disabled .slot-name {
                color: #64748b;
            }

            .slot-box.disabled .slot-icon-text {
                color: #94a3b8;
                font-size: 15px;
            }

            .slot-box.disabled .slot-badge {
                color: #94a3b8;
                font-weight: 500;
            }

    .slot-name {
        font-weight: 700;
        font-size: 10px;
        line-height: 1;
        width: 100%;
        text-align: center;
    }

    .slot-icon-area {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-grow: 1;
    }

    .slot-badge {
        font-size: 9px;
        line-height: 1.1;
        width: 100%;
        text-align: center;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>

@{
    var phieuDict = ViewBag.PhieuDangGui as Dictionary<int, string> ?? new Dictionary<int, string>();
    var danhSachTang = soDo.Select(v => v.Tang).Distinct().OrderBy(t => t).ToList();
}

<div class="w-100">
    <!-- HIỂN THỊ THÔNG BÁO THÀNH CÔNG / THẤT BẠI -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-dark fw-bold m-0 fs-3">Quản lý Vị trí đỗ xe</h2>
            <p class="text-secondary small mb-0 mt-1">Theo dõi sơ đồ không gian, trạng thái và điều phối vị trí đỗ xe</p>
        </div>
        <div>
            @if (isAdmin)
            {
                <a asp-action="Create" class="btn btn-primary px-3 py-2 fw-semibold shadow-sm d-inline-flex align-items-center gap-2 rounded-3">
                    <i class="bi bi-plus-circle"></i> Tạo mới vị trí
                </a>
            }
        </div>
    </div>

    <!-- SƠ ĐỒ ĐỖ XE TRỰC QUAN -->
    <div class="mb-4">
        @foreach (var tangNum in danhSachTang)
        {
            var vitriTheoTang = soDo.Where(v => v.Tang == tangNum).ToList();

            <div class="parking-header-bar d-flex justify-content-between align-items-center mb-3 shadow-sm">
                <span><i class="bi bi-box-arrow-in-right me-2"></i>Cổng vào</span>
                <span class="fs-6 fw-bold">Tầng @tangNum</span>
                <span>Cổng ra <i class="bi bi-box-arrow-right ms-2"></i></span>
            </div>

            <div class="row g-3 mb-4">
                @foreach (var khuGroup in vitriTheoTang.GroupBy(v => v.KhuVuc).OrderBy(g => g.Key))
                {
                    string tenKhuGoc = khuGroup.Key.Trim();
                    string khuNameHienThi = tenKhuGoc.StartsWith("Khu", StringComparison.OrdinalIgnoreCase) ? tenKhuGoc : "Khu " + tenKhuGoc;

                    int tongCho = khuGroup.Count();
                    int choTrong = khuGroup.Count(v => v.TrangThai == "Còn trống");

                    string zoneClass = tenKhuGoc.Contains("B") ? "zone-b" : (tenKhuGoc.Contains("C") ? "zone-c" : (tenKhuGoc.Contains("D") ? "zone-d" : "zone-a"));
                    string zoneLetter = tenKhuGoc.Replace("Khu", "").Trim();
                    if (string.IsNullOrEmpty(zoneLetter)) { zoneLetter = "A"; }
                    else if (zoneLetter.Length > 1) { zoneLetter = zoneLetter.Substring(0, 1); }

                    <div class="col-12 col-md-6 col-xl-6">
                        <div class="zone-card p-3 @zoneClass">
                            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="zone-icon">@zoneLetter</div>
                                    <div>
                                        <h6 class="fw-bold m-0 text-dark fs-6">@khuNameHienThi</h6>
                                        <small class="text-secondary">Tổng số: @tongCho chỗ</small>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span class="fw-bold text-primary small">@choTrong trống</span>
                                    <div class="progress mt-1" style="width: 70px; height: 5px;">
                                        <div class="progress-bar bg-primary" style="width: @(tongCho > 0 ? (choTrong * 100 / tongCho) : 0)%"></div>
                                    </div>
                                </div>
                            </div>

                            @foreach (var loaiGroup in khuGroup.GroupBy(v => v.LoaiPhuongTien?.TenLoaiPhuongTien ?? "Phương tiện khác"))
                            {
                                int subTong = loaiGroup.Count();
                                int subTrong = loaiGroup.Count(v => v.TrangThai == "Còn trống");

                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-semibold small text-secondary">@loaiGroup.Key</span>
                                        <small class="text-muted fw-semibold">@subTrong / @subTong trống</small>
                                    </div>

                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var slot in loaiGroup)
                                        {
                                            string statusClass = slot.TrangThai == "Đang sử dụng" ? "occupied" : (slot.TrangThai == "Tạm ngừng" ? "disabled" : "empty");
                                            string bienSo = phieuDict.ContainsKey(slot.MaViTri) ? phieuDict[slot.MaViTri] : "";

                                            if (isAdmin)
                                            {
                                                <form asp-action="ToggleTamNgung" asp-route-id="@slot.MaViTri" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit"
                                                            class="slot-box @statusClass btn p-1"
                                                            title="@slot.TenViTri - @slot.TrangThai @(string.IsNullOrEmpty(bienSo) ? "" : $"({bienSo})")"
                                                            onclick="@(slot.TrangThai == "Đang sử dụng"
                                                                ? "alert('Không thể tạm ngừng vị trí này vì đang có xe đỗ!'); return false;"
                                                                : (slot.TrangThai == "Tạm ngừng"
                                                                    ? $"return confirm('Mở lại hoạt động vị trí {slot.TenViTri}?');"
                                                                    : $"return confirm('Xác nhận Tạm ngừng vị trí {slot.TenViTri}?');"))">
                                                        <div class="slot-name">@slot.TenViTri</div>
                                                        <div class="slot-icon-area">
                                                            @if (slot.TrangThai == "Đang sử dụng")
                                                            {
                                                                <i class="bi bi-geo-fill slot-icon-text"></i>
                                                            }
                                                            else if (slot.TrangThai == "Tạm ngừng")
                                                            {
                                                                <i class="bi bi-slash-circle slot-icon-text"></i>
                                                            }
                                                            else
                                                            {
                                                                <span class="slot-icon-text">P</span>
                                                            }
                                                        </div>
                                                        <div class="slot-badge">
                                                            @(slot.TrangThai == "Đang sử dụng" ? (string.IsNullOrEmpty(bienSo) ? "Có xe" : bienSo) : (slot.TrangThai == "Tạm ngừng" ? "Ngừng" : "Trống"))
                                                        </div>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <div class="slot-box @statusClass" title="@slot.TenViTri - @slot.TrangThai">
                                                    <div class="slot-name">@slot.TenViTri</div>
                                                    <div class="slot-icon-area">
                                                        @if (slot.TrangThai == "Đang sử dụng")
                                                        {
                                                            <i class="bi bi-geo-fill slot-icon-text"></i>
                                                        }
                                                        else if (slot.TrangThai == "Tạm ngừng")
                                                        {
                                                            <i class="bi bi-slash-circle slot-icon-text"></i>
                                                        }
                                                        else
                                                        {
                                                            <span class="slot-icon-text">P</span>
                                                        }
                                                    </div>
                                                    <div class="slot-badge">
                                                        @(slot.TrangThai == "Đang sử dụng" ? (string.IsNullOrEmpty(bienSo) ? "Có xe" : bienSo) : (slot.TrangThai == "Tạm ngừng" ? "Ngừng" : "Trống"))
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- BỘ LỌC TÌM KIẾM -->
    <div class="card shadow-sm mb-4 border-0 rounded-4">
        <div class="card-body bg-light p-4 rounded-4">
            <form asp-action="Index" method="get">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-secondary">Tìm kiếm vị trí:</label>
                        <input type="text"
                               name="searchString"
                               value="@ViewData["CurrentSearch"]"
                               class="form-control rounded-3"
                               placeholder="Nhập tên vị trí hoặc khu vực..." />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold small text-secondary">Loại phương tiện:</label>
                        <select name="maLoaiPhuongTien" class="form-select rounded-3" asp-items="ViewBag.MaLoaiPhuongTien">
                            <option value="">-- Tất cả --</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold small text-secondary">Khu vực:</label>
                        <select name="khuVuc" class="form-select rounded-3" asp-items="ViewBag.KhuVucList">
                            <option value="">-- Tất cả --</option>
                        </select>
                    </div>

                    <div class="col-md-1">
                        <label class="form-label fw-bold small text-secondary">Tầng:</label>
                        <select name="tang" class="form-select rounded-3" asp-items="ViewBag.TangList">
                            <option value="">-- Tất cả --</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold small text-secondary">Trạng thái:</label>
                        <select name="trangThai" class="form-select rounded-3">
                            <option value="">-- Tất cả --</option>
                            <option value="Còn trống" selected="@(currentTrangThai == "Còn trống")">Còn trống</option>
                            <option value="Đang sử dụng" selected="@(currentTrangThai == "Đang sử dụng")">Đang sử dụng</option>
                            <option value="Tạm ngừng" selected="@(currentTrangThai == "Tạm ngừng")">Tạm ngừng</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold small text-secondary">Sắp xếp theo:</label>
                        <select name="sortOrder" class="form-select rounded-3">
                            <option value="name_asc" selected="@(currentSort == "name_asc")">Tên A -> Z</option>
                            <option value="name_desc" selected="@(currentSort == "name_desc")">Tên Z -> A</option>
                            <option value="tang_asc" selected="@(currentSort == "tang_asc")">Tầng tăng dần</option>
                            <option value="tang_desc" selected="@(currentSort == "tang_desc")">Tầng giảm dần</option>
                        </select>
                    </div>

                    <div class="col-md-12 text-end mt-3">
                        <button type="submit" class="btn btn-success me-1 px-4 rounded-3 fw-semibold"><i class="bi bi-funnel"></i> Lọc & Sắp xếp</button>
                        <a asp-action="Index" class="btn btn-secondary px-4 rounded-3 fw-semibold">Đặt lại</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- BẢNG HIỂN THỊ DỮ LIỆU -->
    <div class="table-container">
        <div class="table-responsive">
            <table class="table custom-table">
                <thead>
                    <tr>
                        <th>Tên vị trí</th>
                        <th>Khu vực</th>
                        <th>Tầng</th>
                        <th>Loại phương tiện</th>
                        <th class="text-center">Trạng thái</th>
                        <th>Mô tả</th>
                        <th style="width: 170px; text-align: center;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                Không tìm thấy vị trí đỗ xe nào phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="fw-bold text-dark">@Html.DisplayFor(modelItem => item.TenViTri)</span></td>
                                <td><span class="text-secondary">@Html.DisplayFor(modelItem => item.KhuVuc)</span></td>
                                <td><span class="text-secondary">Tầng @Html.DisplayFor(modelItem => item.Tang)</span></td>
                                <td>
                                    <span class="badge bg-info bg-opacity-10 text-info fw-semibold px-2 py-1">
                                        @(item.LoaiPhuongTien != null ? item.LoaiPhuongTien.TenLoaiPhuongTien : "N/A")
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (item.TrangThai == "Còn trống")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fw-semibold">Còn trống</span>
                                    }
                                    else if (item.TrangThai == "Đang sử dụng")
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill fw-semibold">Đang sử dụng</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill fw-semibold">Tạm ngừng</span>
                                    }
                                </td>
                                <td><span class="text-secondary">@(string.IsNullOrEmpty(item.MoTa) ? "---" : item.MoTa)</span></td>
                                <td class="text-center">
                                    <div class="action-group">
                                        <a asp-action="Details" asp-route-mavitri="@item.MaViTri" class="action-btn view" title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (isAdmin)
                                        {
                                            <form asp-action="ToggleTamNgung" asp-route-id="@item.MaViTri" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="action-btn toggle-btn"
                                                        title="@(item.TrangThai == "Tạm ngừng" ? "Mở lại hoạt động" : "Tạm ngừng (Báo sự cố)")"
                                                        onclick="@(item.TrangThai == "Đang sử dụng"
                                                            ? "alert('Không thể tạm ngừng vị trí này vì đang có xe đỗ!'); return false;"
                                                            : (item.TrangThai == "Tạm ngừng"
                                                                ? $"return confirm('Mở lại hoạt động vị trí {item.TenViTri}?');"
                                                                : $"return confirm('Xác nhận Tạm ngừng vị trí {item.TenViTri}?');"))">
                                                    <i class="bi @(item.TrangThai == "Tạm ngừng" ? "bi-play-circle text-success" : "bi-pause-circle text-warning")"></i>
                                                </button>
                                            </form>

                                            <a asp-action="Edit" asp-route-mavitri="@item.MaViTri" class="action-btn edit" title="Sửa thông tin">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-mavitri="@item.MaViTri" class="action-btn delete" title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- PHÂN TRANG -->
    @if (totalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-center mb-0">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link rounded-start-3"
                       asp-action="Index"
                       asp-route-page="@(currentPage - 1)"
                       asp-route-searchString="@ViewBag.CurrentSearch"
                       asp-route-maLoaiPhuongTien="@ViewBag.CurrentLoaiPhuongTien"
                       asp-route-khuVuc="@ViewBag.CurrentKhuVuc"
                       asp-route-tang="@ViewBag.CurrentTang"
                       asp-route-trangThai="@ViewBag.CurrentTrangThai"
                       asp-route-sortOrder="@ViewBag.CurrentSort">Trước</a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(currentPage == i ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-searchString="@ViewBag.CurrentSearch"
                           asp-route-maLoaiPhuongTien="@ViewBag.CurrentLoaiPhuongTien"
                           asp-route-khuVuc="@ViewBag.CurrentKhuVuc"
                           asp-route-tang="@ViewBag.CurrentTang"
                           asp-route-trangThai="@ViewBag.CurrentTrangThai"
                           asp-route-sortOrder="@ViewBag.CurrentSort">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link rounded-end-3"
                       asp-action="Index"
                       asp-route-page="@(currentPage + 1)"
                       asp-route-searchString="@ViewBag.CurrentSearch"
                       asp-route-maLoaiPhuongTien="@ViewBag.CurrentLoaiPhuongTien"
                       asp-route-khuVuc="@ViewBag.CurrentKhuVuc"
                       asp-route-tang="@ViewBag.CurrentTang"
                       asp-route-trangThai="@ViewBag.CurrentTrangThai"
                       asp-route-sortOrder="@ViewBag.CurrentSort">Sau</a>
                </li>
            </ul>
        </nav>
    }
</div>
