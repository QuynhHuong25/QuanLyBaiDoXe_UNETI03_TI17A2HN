@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@model IEnumerable<QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.ViTriDoXe>

@{
    ViewData["Title"] = "Quản lý Vị trí đỗ xe";
    var vaiTro = HttpContextAccessor.HttpContext?.Session.GetString("VaiTro");
    bool isAdmin = !string.IsNullOrEmpty(vaiTro) &&
                  (vaiTro.Equals("Admin", StringComparison.OrdinalIgnoreCase));

    var currentSort = ViewData["CurrentSort"]?.ToString();
    var currentTrangThai = ViewData["CurrentTrangThai"]?.ToString();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Danh sách Vị trí đỗ xe</h2>
    <div>
        @if (isAdmin)
        {
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Tạo mới</a>
        }
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body bg-light">
        <form asp-action="Index" method="get">
            <div class="row g-2">
                <!--tim kiem -->
                <div class="col-md-3">
                    <label class="form-label font-weight-bold">Tìm kiếm vị trí:</label>
                    <input type="text"
                           name="searchString"
                           value="@ViewData["CurrentSearch"]"
                           class="form-control"
                           placeholder="Nhập tên vị trí hoặc khu vực..." />
                </div>

                <!--lọc phương tiện-->
                <div class="col-md-2">
                    <label class="form-label font-weight-bold">Loại phương tiện:</label>
                    <select name="maLoaiPhuongTien" class="form-select" asp-items="ViewBag.MaLoaiPhuongTien">
                        <option value="">-- Tất cả --</option>
                    </select>
                </div>

                <!-- lọc khu vuẽc-->
                <div class="col-md-2">
                    <label class="form-label font-weight-bold">Khu vực:</label>
                    <select name="khuVuc" class="form-select" asp-items="ViewBag.KhuVucList">
                        <option value="">-- Tất cả --</option>
                    </select>
                </div>

                <!--lọc tầng-->
                <div class="col-md-1">
                    <label class="form-label font-weight-bold">Tầng:</label>
                    <select name="tang" class="form-select" asp-items="ViewBag.TangList">
                        <option value="">-- Tất cả --</option>
                    </select>
                </div>

                <!-- lọc tragnj thái -->
                <div class="col-md-2">
                    <label class="form-label font-weight-bold">Trạng thái:</label>
                    <select name="trangThai" class="form-select">
                        <option value="">-- Tất cả --</option>
                        <option value="Còn trống" selected="@(currentTrangThai == "Còn trống")">Còn trống</option>
                        <option value="Đang sử dụng" selected="@(currentTrangThai == "Đang sử dụng")">Đang sử dụng</option>
                        <option value="Tạm ngừng" selected="@(currentTrangThai == "Tạm ngừng")">Tạm ngừng</option>
                    </select>
                </div>

                <!--sắp xếp-->
                <div class="col-md-2">
                    <label class="form-label font-weight-bold">Sắp xếp theo:</label>
                    <select name="sortOrder" class="form-select">
                        <option value="name_asc" selected="@(currentSort == "name_asc")">Tên A -> Z</option>
                        <option value="name_desc" selected="@(currentSort == "name_desc")">Tên Z -> A</option>
                        <option value="tang_asc" selected="@(currentSort == "tang_asc")">Tầng tăng dần</option>
                        <option value="tang_desc" selected="@(currentSort == "tang_desc")">Tầng giảm dần</option>
                    </select>
                </div>

                <div class="col-md-12 text-end mt-3">
                    <button type="submit" class="btn btn-success me-1"><i class="bi bi-funnel"></i> Lọc & Sắp xếp</button>
                    <a asp-action="Index" class="btn btn-secondary">Đặt lại</a>
                </div>
            </div>
        </form>
    </div>
</div>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>Tên vị trí</th>
            <th>Khu vực</th>
            <th>Tầng</th>
            <th>Loại phương tiện</th>
            <th>Trạng thái</th>
            <th>Mô tả</th>
            <th style="width: 180px;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted">Không tìm thấy vị trí đỗ xe nào phù hợp.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td class="font-weight-bold text-primary">@Html.DisplayFor(modelItem => item.TenViTri)</td>
                    <td>@Html.DisplayFor(modelItem => item.KhuVuc)</td>
                    <td>Tầng @Html.DisplayFor(modelItem => item.Tang)</td>
                    <td>
                        <span class="badge bg-info text-dark">
                            @(item.LoaiPhuongTien != null ? item.LoaiPhuongTien.TenLoaiPhuongTien : "N/A")
                        </span>
                    </td>
                    <td>
                        @if (item.TrangThai == "Còn trống")
                        {
                            <span class="badge bg-success">Còn trống</span>
                        }
                        else if (item.TrangThai == "Đang sử dụng")
                        {
                            <span class="badge bg-danger">Đang sử dụng</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Tạm ngừng</span>
                        }
                    </td>
                    <td>@Html.DisplayFor(modelItem => item.MoTa)</td>
                    <td>
                        <a asp-action="Details" asp-route-mavitri="@item.MaViTri" class="btn btn-sm btn-info">Chi tiết</a>
                        @if (isAdmin)
                        {
                            <a asp-action="Edit" asp-route-mavitri="@item.MaViTri" class="btn btn-sm btn-warning">Sửa</a>
                            <a asp-action="Delete" asp-route-mavitri="@item.MaViTri" class="btn btn-sm btn-danger">Xóa</a>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
