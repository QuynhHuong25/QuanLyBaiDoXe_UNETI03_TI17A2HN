@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@model IEnumerable<QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.ViTriDoXe>

@{
    ViewData["Title"] = "Quản lý Vị trí đỗ xe";
    var vaiTro = HttpContextAccessor.HttpContext?.Session.GetString("VaiTro");
    bool isAdmin = !string.IsNullOrEmpty(vaiTro) &&
                  (vaiTro.Equals("Admin", StringComparison.OrdinalIgnoreCase));

    var currentSort = ViewData["CurrentSort"]?.ToString();
    var currentTrangThai = ViewData["CurrentTrangThai"]?.ToString();

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
    var soDo = ViewBag.SoDo as List<QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.ViTriDoXe>
            ?? new List<QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.ViTriDoXe>();

    // Tính toán chỉ số thống kê
    int tongSoCho = soDo.Count;
    int tongConTrong = soDo.Count(v => v.TrangThai == "Còn trống");
    int tongDangSuDung = soDo.Count(v => v.TrangThai == "Đang sử dụng");
    int tongTamNgung = soDo.Count(v => v.TrangThai == "Tạm ngừng");

    var phieuDict = ViewBag.PhieuDangGui as Dictionary<int, string> ?? new Dictionary<int, string>();
    var danhSachTang = soDo.Select(v => v.Tang).Distinct().OrderBy(t => t).ToList();
    int activeTang = ViewBag.ActiveTang ?? (danhSachTang.FirstOrDefault());
}

<style>
    /* THỐNG KÊ TỔNG QUAN (4 BOXES) */
    .stat-card {
        background-color: #f8fafc;
        border-radius: 12px;
        padding: 16px 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        border: 1px solid #f1f5f9;
    }

    .stat-pill {
        width: 8px;
        height: 38px;
        border-radius: 4px;
        flex-shrink: 0;
    }

        .stat-pill.gray {
            background-color: #94a3b8;
        }

        .stat-pill.green {
            background-color: #22c55e;
        }

        .stat-pill.red {
            background-color: #ef4444;
        }

    .stat-number {
        font-size: 24px;
        font-weight: 800;
        line-height: 1;
        color: #0f172a;
    }

    .stat-label {
        font-size: 13px;
        color: #64748b;
        margin-top: 4px;
        font-weight: 500;
    }

    /* TAB CHỌN TẦNG */
    .tang-tab-btn {
        border-radius: 10px;
        padding: 8px 18px;
        font-weight: 700;
        font-size: 13px;
        border: 1px solid #e2e8f0;
        background-color: #ffffff;
        color: #1e293b;
        text-decoration: none !important;
        display: inline-block;
        transition: all 0.2s;
    }

        .tang-tab-btn.active {
            background-color: #0b1f4c;
            color: #ffffff;
            border-color: #0b1f4c;
        }

    /* BAR CỔNG VÀO / CỔNG RA */
    .parking-header-bar {
        background-color: #0b1f4c;
        color: #ffffff;
        border-radius: 20px;
        padding: 10px 24px;
        font-weight: 700;
        font-size: 14px;
    }

    /* ZONE CARD & SLOTS */
    .zone-card {
        border-radius: 14px;
        border: 1px solid #e2e8f0;
        background-color: #ffffff;
        box-shadow: 0 2px 8px rgba(0,0,0,0.02);
    }

    .zone-icon-blue {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background-color: #2563eb;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 16px;
    }

    /* SƠ ĐỒ Ô ĐỖ XE KIỂU MỚI */
    .slot-box {
        width: 68px;
        height: 82px;
        border-radius: 6px;
        text-align: center;
        padding: 4px 2px;
        position: relative;
        cursor: pointer;
        transition: all 0.15s ease-in-out;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        text-decoration: none !important;
    }

        .slot-box:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        }

    .slot-name {
        font-weight: 700;
        font-size: 11px;
        color: #475569;
    }

    /* TRẠNG THÁI TRỐNG */
    .slot-box.empty {
        background-color: #f0fdf4;
        border-color: #bbf7d0;
    }

        .slot-box.empty .slot-icon-text {
            color: #4ade80;
            font-size: 20px;
            font-weight: 800;
        }

        .slot-box.empty .slot-badge {
            color: #16a34a;
            font-weight: 700;
            font-size: 11px;
        }

    /* TRẠNG THÁI ĐANG SỬ DỤNG (CÓ XE) */
    .slot-box.occupied {
        background-color: #ffffff;
        border-color: #fca5a5;
    }

        .slot-box.occupied .slot-icon-text {
            color: #ef4444;
            font-size: 18px;
        }

        .slot-box.occupied .slot-badge-plate {
            border: 1px solid #f87171;
            color: #b91c1c;
            font-weight: 800;
            font-size: 9px;
            border-radius: 3px;
            padding: 0 2px;
            width: 100%;
            max-width: 100%;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            background: #fff5f5;
        }

    /* TRẠNG THÁI TẠM NGỪNG */
    .slot-box.disabled {
        background-color: #f1f5f9;
        border-color: #cbd5e1;
        background-image: repeating-linear-gradient(45deg, transparent, transparent 5px, rgba(203, 213, 225, 0.4) 5px, rgba(203, 213, 225, 0.4) 10px);
    }

        .slot-box.disabled .slot-icon-text {
            color: #94a3b8;
            font-size: 16px;
        }

        .slot-box.disabled .slot-badge {
            color: #64748b;
            font-weight: 600;
            font-size: 10px;
        }

    /* BẢNG DỮ LIỆU & NÚT THAO TÁC */
    .table-container {
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(11,31,77,0.05);
        overflow: hidden;
        border: 1px solid #e2e8f0;
    }

    .custom-table {
        margin-bottom: 0;
        width: 100%;
    }

        .custom-table thead th {
            background-color: #f8fafc !important;
            color: #475569 !important;
            border-bottom: 2px solid #e2e8f0;
            padding: 14px 16px;
            font-weight: 700;
            font-size: 13px;
            text-transform: uppercase;
        }

        .custom-table tbody td {
            padding: 16px;
            vertical-align: middle;
            border-bottom: 1px solid #f1f5f9;
            font-size: 14px;
        }

    .action-group {
        display: inline-flex;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        overflow: hidden;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 32px;
        border-right: 1px solid #cbd5e1;
        background: none;
        cursor: pointer;
    }

        .action-btn:last-child {
            border-right: none;
        }

        .action-btn.view {
            color: #0ea5e9;
        }

        .action-btn.edit {
            color: #d97706;
        }

        .action-btn.delete {
            color: #ef4444;
        }

        .action-btn.toggle-btn {
            color: #64748b;
        }
</style>

<div class="w-100">
    <!-- HIỂN THỊ THÔNG BÁO THÀNH CÔNG / THẤT BẠI -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-dark fw-bold m-0 fs-3">Quản lý Vị trí đỗ xe</h2>
            <p class="text-secondary small mb-0 mt-1">Theo dõi sơ đồ không gian, trạng thái và điều phối vị trí đỗ xe</p>
        </div>
        <div>
            @if (isAdmin)
            {
                <a asp-action="Create" class="btn btn-primary px-3 py-2 fw-semibold shadow-sm d-inline-flex align-items-center gap-2 rounded-3">
                    <i class="bi bi-plus-circle"></i> Tạo mới vị trí
                </a>
            }
        </div>
    </div>

    <!-- KHUNG TỔNG QUAN TÌNH TRẠNG BÃI XE (4 BOXES) -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <h5 class="fw-bold text-dark mb-3">Sơ đồ bãi đỗ</h5>
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <div class="stat-pill gray"></div>
                    <div>
                        <div class="stat-number">@tongSoCho</div>
                        <div class="stat-label">Tổng số chỗ</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <div class="stat-pill green"></div>
                    <div>
                        <div class="stat-number">@tongConTrong</div>
                        <div class="stat-label">Còn trống</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <div class="stat-pill red"></div>
                    <div>
                        <div class="stat-number">@tongDangSuDung</div>
                        <div class="stat-label">Đang sử dụng</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <div class="stat-pill gray"></div>
                    <div>
                        <div class="stat-number">@tongTamNgung</div>
                        <div class="stat-label">Tạm ngừng</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB CHỌN TẦNG -->
        <div class="d-flex gap-2 mb-4">
            @foreach (var t in danhSachTang)
            {
                int trongTang = soDo.Count(v => v.Tang == t && v.TrangThai == "Còn trống");
                int tongTang = soDo.Count(v => v.Tang == t);
                bool isActive = (t == activeTang);

                <a href="javascript:void(0);" onclick="switchTangTab(@t)" id="tab-btn-@t" class="tang-tab-btn @(isActive ? "active" : "")">
                    Tầng @t <span class="fw-normal ms-1 opacity-75">@trongTang / @tongTang chỗ trống</span>
                </a>
            }
        </div>

        <!-- HIỂN THỊ SƠ ĐỒ THEO TẦNG ĐƯỢC CHỌN -->
        @foreach (var tangNum in danhSachTang)
        {
            var vitriTheoTang = soDo.Where(v => v.Tang == tangNum).ToList();
            bool isDisplay = (tangNum == activeTang);

            <div class="tang-content-block" id="tang-block-@tangNum" style="display: @(isDisplay ? "block" : "none");">
                <!-- BAR CỔNG VÀO / CỔNG RA -->
                <div class="parking-header-bar d-flex justify-content-between align-items-center mb-4 shadow-sm">
                    <span><i class="bi bi-arrow-right me-2"></i>Cổng vào</span>
                    <span class="fs-6 fw-bold">Tầng @tangNum</span>
                    <span>Cổng ra<i class="bi bi-arrow-right ms-2"></i></span>
                </div>

                <!-- CÁC KHU VỰC TRONG TẦNG -->
                <div class="row g-4">
                    @foreach (var khuGroup in vitriTheoTang.GroupBy(v => v.KhuVuc).OrderBy(g => g.Key))
                    {
                        string tenKhuGoc = khuGroup.Key.Trim();
                        string khuNameHienThi = tenKhuGoc.StartsWith("Khu", StringComparison.OrdinalIgnoreCase) ? tenKhuGoc : "Khu " + tenKhuGoc;

                        int tongChoKhu = khuGroup.Count();
                        int choTrongKhu = khuGroup.Count(v => v.TrangThai == "Còn trống");

                        <div class="col-12">
                            <div class="zone-card p-3">
                                <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="zone-icon-blue"><i class="bi bi-p-square-fill"></i></div>
                                        <div>
                                            <h6 class="fw-bold m-0 text-dark fs-6">@khuNameHienThi</h6>
                                            <small class="text-secondary">Sức chứa: @tongChoKhu chỗ</small>
                                        </div>
                                    </div>
                                    <div>
                                        <span class="fw-bold text-primary fs-6">@choTrongKhu trống</span>
                                        <div class="progress mt-1" style="width: 80px; height: 5px;">
                                            <div class="progress-bar bg-primary" style="width: @(tongChoKhu > 0 ? (choTrongKhu * 100 / tongChoKhu) : 0)%"></div>
                                        </div>
                                    </div>
                                </div>

                                @foreach (var loaiGroup in khuGroup.GroupBy(v => v.LoaiPhuongTien?.TenLoaiPhuongTien ?? "Phương tiện khác"))
                                {
                                    int subTong = loaiGroup.Count();
                                    int subTrong = loaiGroup.Count(v => v.TrangThai == "Còn trống");
                                    var slotsOrdered = loaiGroup.OrderBy(v => v.TenViTri).ToList();

                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="fw-bold small text-secondary">@loaiGroup.Key</span>
                                            <small class="text-muted fw-bold">@subTrong / @subTong trống</small>
                                        </div>

                                        <!-- HIỂN THỊ TẤT CẢ CÁC Ô ĐỖ LIỀN MẠCH TRÊN CÙNG 1 HÀNG -->
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var slot in slotsOrdered)
                                            {
                                                @await Html.PartialAsync("_SlotBoxItem", slot, new ViewDataDictionary(ViewData) { { "PhieuDict", phieuDict }, { "IsAdmin", isAdmin } })
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- BỘ LỌC TÌM KIẾM -->
    <div class="card shadow-sm mb-4 border-0 rounded-4">
        <div class="card-body bg-light p-4 rounded-4">
            <form asp-action="Index" method="get">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-secondary">Tìm kiếm vị trí:</label>
                        <input type="text"
                               name="searchString"
                               value="@ViewData["CurrentSearch"]"
                               class="form-control rounded-3"
                               placeholder="Nhập tên vị trí..." />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold small text-secondary">Loại phương tiện:</label>
                        <select name="maLoaiPhuongTien" class="form-select rounded-3" asp-items="ViewBag.MaLoaiPhuongTien">
                            <option value="">-- Tất cả --</option>
                        </select>
                    </div>

                    <!-- Ô KHU VỰC DẠNG DROPDOWN / COMBOBOX -->
                    <div class="col-md-2">
                        <label class="form-label fw-bold small text-secondary">Khu vực:</label>
                        <select name="khuVuc" class="form-select rounded-3" asp-items="ViewBag.KhuVucList">
                            <option value="">-- Tất cả khu vực --</option>
                        </select>
                    </div>

                    <div class="col-md-1">
                        <label class="form-label fw-bold small text-secondary">Tầng:</label>
                        <select name="tang" class="form-select rounded-3" asp-items="ViewBag.TangList">
                            <option value="">-- Tất cả --</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold small text-secondary">Trạng thái:</label>
                        <select name="trangThai" class="form-select rounded-3">
                            <option value="">-- Tất cả --</option>
                            <option value="Còn trống" selected="@(currentTrangThai == "Còn trống")">Còn trống</option>
                            <option value="Đang sử dụng" selected="@(currentTrangThai == "Đang sử dụng")">Đang sử dụng</option>
                            <option value="Tạm ngừng" selected="@(currentTrangThai == "Tạm ngừng")">Tạm ngừng</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold small text-secondary">Sắp xếp theo:</label>
                        <select name="sortOrder" class="form-select rounded-3">
                            <option value="name_asc" selected="@(currentSort == "name_asc")">Tên A -> Z</option>
                            <option value="name_desc" selected="@(currentSort == "name_desc")">Tên Z -> A</option>
                            <option value="tang_asc" selected="@(currentSort == "tang_asc")">Tầng tăng dần</option>
                            <option value="tang_desc" selected="@(currentSort == "tang_desc")">Tầng giảm dần</option>
                        </select>
                    </div>

                    <div class="col-md-12 text-end mt-3">
                        <button type="submit" class="btn btn-success me-1 px-4 rounded-3 fw-semibold"><i class="bi bi-funnel"></i> Lọc & Sắp xếp</button>
                        <a asp-action="Index" class="btn btn-secondary px-4 rounded-3 fw-semibold">Đặt lại</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- BẢNG HIỂN THỊ DỮ LIỆU -->
    <div class="table-container">
        <div class="table-responsive">
            <table class="table custom-table">
                <thead>
                    <tr>
                        <th>Tên vị trí</th>
                        <th>Khu vực</th>
                        <th>Tầng</th>
                        <th>Loại phương tiện</th>
                        <th class="text-center">Trạng thái</th>
                        <th>Mô tả</th>
                        <th style="width: 170px; text-align: center;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                Không tìm thấy vị trí đỗ xe nào phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="fw-bold text-dark">@Html.DisplayFor(modelItem => item.TenViTri)</span></td>
                                <td><span class="text-secondary">@Html.DisplayFor(modelItem => item.KhuVuc)</span></td>
                                <td><span class="text-secondary">Tầng @Html.DisplayFor(modelItem => item.Tang)</span></td>
                                <td>
                                    <span class="badge bg-info bg-opacity-10 text-info fw-semibold px-2 py-1">
                                        @(item.LoaiPhuongTien != null ? item.LoaiPhuongTien.TenLoaiPhuongTien : "N/A")
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (item.TrangThai == "Còn trống")
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fw-semibold">Còn trống</span>
                                    }
                                    else if (item.TrangThai == "Đang sử dụng")
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill fw-semibold">Đang sử dụng</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill fw-semibold">Tạm ngừng</span>
                                    }
                                </td>
                                <td><span class="text-secondary">@(string.IsNullOrEmpty(item.MoTa) ? "---" : item.MoTa)</span></td>
                                <td class="text-center">
                                    <div class="action-group">
                                        <a asp-action="Details" asp-route-mavitri="@item.MaViTri" class="action-btn view" title="Chi tiết">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (isAdmin)
                                        {
                                            <form asp-action="ToggleTamNgung" asp-route-id="@item.MaViTri" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="action-btn toggle-btn"
                                                        title="@(item.TrangThai == "Tạm ngừng" ? "Mở lại hoạt động" : "Tạm ngừng (Báo sự cố)")"
                                                        onclick="@(item.TrangThai == "Đang sử dụng"
                                                            ? "alert('Không thể tạm ngừng vị trí này vì đang có xe đỗ!'); return false;"
                                                            : (item.TrangThai == "Tạm ngừng"
                                                                ? $"return confirm('Mở lại hoạt động vị trí {item.TenViTri}?');"
                                                                : $"return confirm('Xác nhận Tạm ngừng vị trí {item.TenViTri}?');"))">
                                                    <i class="bi @(item.TrangThai == "Tạm ngừng" ? "bi-play-circle text-success" : "bi-pause-circle text-warning")"></i>
                                                </button>
                                            </form>

                                            <a asp-action="Edit" asp-route-mavitri="@item.MaViTri" class="action-btn edit" title="Sửa thông tin">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-mavitri="@item.MaViTri" class="action-btn delete" title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- PHÂN TRANG -->
    @if (totalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-center mb-0">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link rounded-start-3"
                       asp-action="Index"
                       asp-route-page="@(currentPage - 1)"
                       asp-route-searchString="@ViewBag.CurrentSearch"
                       asp-route-maLoaiPhuongTien="@ViewBag.CurrentLoaiPhuongTien"
                       asp-route-khuVuc="@ViewBag.CurrentKhuVuc"
                       asp-route-tang="@ViewBag.CurrentTang"
                       asp-route-trangThai="@ViewBag.CurrentTrangThai"
                       asp-route-sortOrder="@ViewBag.CurrentSort">Trước</a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(currentPage == i ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-searchString="@ViewBag.CurrentSearch"
                           asp-route-maLoaiPhuongTien="@ViewBag.CurrentLoaiPhuongTien"
                           asp-route-khuVuc="@ViewBag.CurrentKhuVuc"
                           asp-route-tang="@ViewBag.CurrentTang"
                           asp-route-trangThai="@ViewBag.CurrentTrangThai"
                           asp-route-sortOrder="@ViewBag.CurrentSort">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link rounded-end-3"
                       asp-action="Index"
                       asp-route-page="@(currentPage + 1)"
                       asp-route-searchString="@ViewBag.CurrentSearch"
                       asp-route-maLoaiPhuongTien="@ViewBag.CurrentLoaiPhuongTien"
                       asp-route-khuVuc="@ViewBag.CurrentKhuVuc"
                       asp-route-tang="@ViewBag.CurrentTang"
                       asp-route-trangThai="@ViewBag.CurrentTrangThai"
                       asp-route-sortOrder="@ViewBag.CurrentSort">Sau</a>
                </li>
            </ul>
        </nav>
    }
</div>

<script>
    function switchTangTab(tangNum) {
        // Hide all blocks
        document.querySelectorAll('.tang-content-block').forEach(el => el.style.display = 'none');
        // Remove active class
        document.querySelectorAll('.tang-tab-btn').forEach(el => el.classList.remove('active'));

        // Show selected
        const selectedBlock = document.getElementById('tang-block-' + tangNum);
        if (selectedBlock) selectedBlock.style.display = 'block';

        const selectedBtn = document.getElementById('tab-btn-' + tangNum);
        if (selectedBtn) selectedBtn.classList.add('active');
    }
</script>
