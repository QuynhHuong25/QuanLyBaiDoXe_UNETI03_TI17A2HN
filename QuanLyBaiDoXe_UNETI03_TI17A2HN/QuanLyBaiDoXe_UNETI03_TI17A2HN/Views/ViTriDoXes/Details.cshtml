@model QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.ViTriDoXe

@{
    ViewData["Title"] = "Chi tiết Vị trí đỗ xe";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-info-circle"></i> Chi tiết Vị trí đỗ xe: @Model.TenViTri</h4>
        </div>
        <div class="card-body">
         
            <dl class="row mb-0">
                
                <dt class="col-sm-3 font-weight-bold">Tên vị trí:</dt>
                <dd class="col-sm-9 text-primary font-weight-bold">@Html.DisplayFor(model => model.TenViTri)</dd>

                <dt class="col-sm-3 font-weight-bold">Loại phương tiện:</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-info text-dark">
                        @(Model.LoaiPhuongTien != null ? Model.LoaiPhuongTien.TenLoaiPhuongTien : "Chưa xác định")
                    </span>
                </dd>

                <dt class="col-sm-3 font-weight-bold">Khu vực:</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.KhuVuc)</dd>

                <dt class="col-sm-3 font-weight-bold">Tầng:</dt>
                <dd class="col-sm-9">Tầng @Html.DisplayFor(model => model.Tang)</dd>

                <dt class="col-sm-3 font-weight-bold">Trạng thái:</dt>
                <dd class="col-sm-9">
                    @if (Model.TrangThai == "Còn trống")
                    {
                        <span class="badge bg-success">Còn trống</span>
                    }
                    else if (Model.TrangThai == "Đang sử dụng")
                    {
                        <span class="badge bg-danger">Đang sử dụng</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Tạm ngừng</span>
                    }
                </dd>

                <dt class="col-sm-3 font-weight-bold">Mô tả:</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrEmpty(Model.MoTa) ? "Không có mô tả" : Model.MoTa)
                </dd>

            </dl>
        </div>
        <div class="card-footer text-end">
     
            <a asp-action="Edit" asp-route-mavitri="@Model?.MaViTri" class="btn btn-warning"><i class="bi bi-pencil-square"></i> Sửa vị trí này</a>
            <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Trở về danh sách</a>
        </div>
    </div>
</div>
