@model QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.ViTriDoXe

@{
    ViewData["Title"] = "Tạo mới Vị trí đỗ xe";
}

<h1>Tạo mới Vị trí đỗ xe</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="TenViTri" class="control-label font-weight-bold">Tên vị trí (*)</label>
                <input asp-for="TenViTri" class="form-control" required />
                <span asp-validation-for="TenViTri" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="MaLoaiPhuongTien" class="control-label font-weight-bold">Loại phương tiện (*)</label>
                <select asp-for="MaLoaiPhuongTien" class="form-select" asp-items="ViewBag.MaLoaiPhuongTien">
                    <option value="">-- Chọn loại phương tiện --</option>
                </select>
                <span asp-validation-for="MaLoaiPhuongTien" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="KhuVuc" class="control-label font-weight-bold">Khu vực (*)</label>
                <input asp-for="KhuVuc" class="form-control" required />
                <span asp-validation-for="KhuVuc" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Tang" class="control-label font-weight-bold">Tầng (*)</label>
                <input asp-for="Tang" type="number" class="form-control" min="1" value="1" required />
                <span asp-validation-for="Tang" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="TrangThai" class="control-label font-weight-bold">Trạng thái (*)</label>
                <select asp-for="TrangThai" class="form-select">
                    <option value="Còn trống">Còn trống</option>
                    <option value="Đang sử dụng">Đang sử dụng</option>
                    <option value="Tạm ngừng">Tạm ngừng</option>
                </select>
                <span asp-validation-for="TrangThai" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="MoTa" class="control-label font-weight-bold">Mô tả</label>
                <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
                <span asp-validation-for="MoTa" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Tạo mới" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Trở về danh sách</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
