@model QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.ViTriDoXe

@{
    ViewData["Title"] = "Xóa Vị trí đỗ xe";
}

<div class="row justify-content-center mt-0">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow border-danger">
            <div class="card-header bg-danger text-white text-center">
                <h3 class="mb-0">Cảnh báo: Xác nhận xóa vị trí đỗ xe?</h3>
            </div>
            <div class="card-body">
                <p class="text-danger font-weight-bold text-center">Bạn có chắc chắn muốn xóa vị trí đỗ xe này khỏi hệ thống không?</p>
                
                <dl class="row mb-0">
                    <dt class="col-sm-4 font-weight-bold">Tên vị trí:</dt>
                    <dd class="col-sm-8 text-primary font-weight-bold">@Html.DisplayFor(model => model.TenViTri)</dd>

                    <dt class="col-sm-4 font-weight-bold">Loại phương tiện:</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-info text-dark">
                            @(Model.LoaiPhuongTien != null ? Model.LoaiPhuongTien.TenLoaiPhuongTien : "Chưa xác định")
                        </span>
                    </dd>

                    <dt class="col-sm-4 font-weight-bold">Khu vực:</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.KhuVuc)</dd>

                    <dt class="col-sm-4 font-weight-bold">Tầng:</dt>
                    <dd class="col-sm-8">Tầng @Html.DisplayFor(model => model.Tang)</dd>

                    <dt class="col-sm-4 font-weight-bold">Trạng thái:</dt>
                    <dd class="col-sm-8">
                        @if (Model.TrangThai == "Còn trống")
                        {
                            <span class="badge bg-success">Còn trống</span>
                        }
                        else if (Model.TrangThai == "Đang sử dụng")
                        {
                            <span class="badge bg-danger">Đang sử dụng</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Tạm ngừng</span>
                        }
                    </dd>

                    <dt class="col-sm-4 font-weight-bold">Mô tả:</dt>
                    <dd class="col-sm-8">
                        @(string.IsNullOrEmpty(Model.MoTa) ? "Không có mô tả" : Model.MoTa)
                    </dd>
                </dl>

                <form asp-action="Delete" class="mt-4">
                    <input type="hidden" asp-for="MaViTri" />
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Trở về danh sách</a>
                        <button type="submit" class="btn btn-danger px-4"><i class="bi bi-trash"></i> Xác nhận xóa</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
