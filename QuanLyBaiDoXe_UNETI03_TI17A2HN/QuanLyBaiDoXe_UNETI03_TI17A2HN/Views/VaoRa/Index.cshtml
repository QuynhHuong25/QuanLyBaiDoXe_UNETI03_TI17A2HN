@* Họ và tên: Tăng Hoàng Giang *@
@* Mã sinh viên: 23103100031 *@
@* Nội dung thực hiện: Giao diện Quản lý xe Vào / Ra (Module 4) - giao diện thẻ theo demo ParkSmart *@

@model IEnumerable<QuanLyBaiDoXe_UNETI03_TI17A2HN.Models.PhieuGuiXe>

@{
    ViewData["Title"] = "Điều phối Xe Vào/Ra";
}

<div class="ps-eb">VẬN HÀNH</div>
<h1 class="ps-big">Điều phối xe vào / ra</h1>
<p style="color:var(--mu);margin:6px 0 26px">Xác nhận nhanh phương tiện tại cổng kiểm soát.</p>

<!-- VÙNG HIỂN THỊ THÔNG BÁO THÀNH CÔNG / LỖI -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- VÙNG TÌM KIẾM THEO BIỂN SỐ (giữ nguyên chức năng cũ) -->
<form asp-action="Index" method="get" class="d-flex gap-2 flex-wrap mb-4">
    <input type="text" name="searchBienSo" value="@ViewData["searchBienSo"]" class="form-control" style="max-width:280px" placeholder="🔍 Tìm kiếm nhanh biển số xe..." />
    <button type="submit" class="btn btn-primary">Tìm</button>
</form>

<!-- LƯỚI THẺ XE CHỜ VÀO / ĐANG ĐỖ -->
@if (!Model.Any())
{
    <div class="card p-5 text-center" style="color:var(--mu)">
        Không có xe nào đang chờ vào hoặc đang gửi.
    </div>
}
else
{
    <div class="ps-vg">
        @foreach (var item in Model)
        {
            bool choVao = item.TrangThai == "Chờ xác nhận";
            string bienSo = item.PhuongTien?.BienSoXe;

            <div class="card ps-vc">
                <div style="display:flex;justify-content:space-between;align-items:center">
                    <span class="ps-vt @(choVao ? "w" : "p")">@(choVao ? "XE CHỜ VÀO" : "XE ĐANG ĐỖ")</span>
                    <span style="color:var(--mu)">
                        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11l1.5-4.5A2 2 0 0 1 8.4 5h7.2a2 2 0 0 1 1.9 1.5L19 11" /><rect x="3" y="11" width="18" height="6" rx="2" /><path d="M6 17v2M18 17v2M7 14h.01M17 14h.01" /></svg>
                    </span>
                </div>

                <div class="ps-pl">@bienSo</div>

                <div class="ps-vi">
                    <div><small>Vị trí</small><b>@(item.ViTriDoXe?.TenViTri ?? "—")</b></div>
                    <div>
                        <small>@(choVao ? "Dự kiến vào" : "Vào thực tế")</small>
                        <b>@(choVao ? item.ThoiGianDuKienVao.ToString("HH:mm") : (item.ThoiGianVaoThucTe?.ToString("HH:mm") ?? "—"))</b>
                    </div>
                </div>

                @if (choVao)
                {
                    <!-- Gọi XacNhanVao trong Controller -->
                    <form asp-action="XacNhanVao" method="post">
                        <input type="hidden" name="id" value="@item.MaPhieu" />
                        <button type="submit" class="btn btn-primary ps-vb" onclick="return confirm('Xác nhận xe @bienSo vào bãi?');">✓ Cho xe vào</button>
                    </form>
                }
                else
                {
                    <!-- Gọi XacNhanRa trong Controller để tính tiền -->
                    <form asp-action="XacNhanRa" method="post">
                        <input type="hidden" name="id" value="@item.MaPhieu" />
                        <button type="submit" class="btn btn-primary ps-vb" onclick="return confirm('Xác nhận xe @bienSo ra bãi và tính tiền?');">✓ Cho xe ra</button>
                    </form>
                }
            </div>
        }
    </div>
}
