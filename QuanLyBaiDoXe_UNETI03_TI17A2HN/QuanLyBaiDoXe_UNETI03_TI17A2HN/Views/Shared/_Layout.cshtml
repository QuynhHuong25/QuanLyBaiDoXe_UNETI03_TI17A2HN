                                    <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main role="main" class="p-3 p-md-4 flex-grow-1">
                <div class="container-fluid p-0">
                    @RenderBody()
                </div>
            </main>

            <footer class="main-footer p-4 mt-auto">
                <div class="container-fluid p-0">
                    <div class="row gy-4">
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="d-flex align-items-center mb-2">
                                <div class="bg-primary text-white rounded-2 d-flex align-items-center justify-content-center me-2 fw-bold fs-5 flex-shrink-0" style="width: 36px; height: 36px;">P</div>
                                <h6 class="m-0 fw-bold fs-6">Quản lý bãi đỗ xe</h6>
                            </div>
