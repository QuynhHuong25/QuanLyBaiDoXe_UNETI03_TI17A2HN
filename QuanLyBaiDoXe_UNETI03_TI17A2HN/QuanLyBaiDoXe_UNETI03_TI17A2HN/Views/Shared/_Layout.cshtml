@* Lương Thị Quỳnh Hương - 23103100064 *@

@using Microsoft.AspNetCore.Http
@{
    string vaiTro = Context.Session?.GetString("VaiTro") ?? "Khach";
    string hoTen = Context.Session?.GetString("HoTen");
    string tenDangNhap = Context.Session?.GetString("TenDangNhap");
    bool isAdmin = vaiTro == "Admin";

    string tenHienThi = !string.IsNullOrEmpty(hoTen)
                        ? hoTen
                        : (!string.IsNullOrEmpty(tenDangNhap) ? tenDangNhap : "Khách hàng");

    // Chữ cái trên avatar: lấy chữ đầu của TÊN (từ cuối cùng trong họ tên)
    var tuTrongTen = tenHienThi.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    string chuCai = tuTrongTen.Length > 0 ? tuTrongTen[^1].Substring(0, 1).ToUpper() : "?";

    // Lấy tên Controller và Action hiện tại để tô sáng menu
    string currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    string currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";

    // Hàm kiểm tra active menu
    bool IsActive(string c, string a) =>
        currentController == c &&
        (a == null || (a == "Create" ? currentAction == "Create" : currentAction != "Create"));

    // Danh sách menu phân quyền
    var menu = isAdmin
        ? new List<(string Ctrl, string Act, string Icon, string Text)>
        {
            ("Home", null, "🏠", "Trang chủ"),
            ("ThongKe", null, "📊", "Tổng quan / Thống kê"),
            ("LoaiPhuongTiens", null, "🏷️", "Loại phương tiện"),
            ("ViTriDoXes", null, "🅿️", "Vị trí đỗ xe"),
            ("ChuPhuongTiens", null, "👥", "Chủ phương tiện"),
            ("PhuongTiens", null, "🚗", "Quản lý phương tiện"),
            ("PhieuGuiXes", null, "📋", "Quản lý phiếu gửi"),
            ("VaoRa", null, "🚪", "Điều phối vào / ra"),
            ("TaiKhoans", null, "🔑", "Tài khoản")
        }
        : new List<(string Ctrl, string Act, string Icon, string Text)>
        {
            ("Home", null, "🏠", "Trang chủ"),
            ("PhieuGuiXes", "Create", "🚗", "Đăng ký gửi xe"),
            ("PhuongTiens", null, "🪪", "Quản lý xe"),
            ("ViTriDoXes", null, "🅿️", "Bãi đỗ xe"),
            ("PhieuGuiXes", "Index", "🕘", "Lịch sử gửi xe"),
            ("ChuPhuongTiens", null, "👤", "Thông tin cá nhân")
        };

    // Tên trang hiện tại hiển thị ở thanh trên
    var mucHienTai = menu.FirstOrDefault(m => IsActive(m.Ctrl, m.Act));
    string tenTrang = mucHienTai.Text ?? (ViewData["Title"]?.ToString() ?? "");
}
<!DOCTYPE html>
<html lang="vi" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ParkSmart</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyBaiDoXe_UNETI03_TI17A2HN.styles.css" asp-append-version="true" />
    @* PHẢI đặt sau cùng để ghi đè Bootstrap *@
    <link rel="stylesheet" href="~/css/parksmart.css" asp-append-version="true" />

    <style>
            .ps-app {
                display: flex;
                min-height: 100vh;
            }

            .ps-content {
                display: flex;
                flex-direction: column;
                flex-grow: 1;
                min-width: 0;
            }

            .ps-main {
                flex-grow: 1;
            }

            .park-footer {
                background-color: #0b1f4d;
                color: #94a3b8;
                padding: 40px 0 20px;
                border-top: 1px solid rgba(255, 255, 255, 0.1);
                margin-top: auto;
                font-size: 13.5px;
            }

                .park-footer h6 {
                    color: #fff;
                    font-weight: 700;
                    font-size: 15px;
                    margin-bottom: 14px;
                }

                .park-footer a {
                    color: #94a3b8;
                    text-decoration: none;
                    display: block;
                    margin-bottom: 8px;
                    transition: color 0.15s;
                }

                    .park-footer a:hover {
                        color: #f5b400;
                    }
    </style>
</head>
<body class="h-100">
    <div class="ps-app">

        <!-- ============ SIDEBAR ============ -->
        <aside class="ps-side" id="sd">
            <a class="ps-logo" asp-controller="Home" asp-action="Index"><i>P</i>ParkSmart</a>

            <h6>@(isAdmin ? "QUẢN TRỊ" : "MENU")</h6>
            @foreach (var m in menu)
            {
                <a class="ps-link @(IsActive(m.Ctrl, m.Act) ? "on" : "")"
                   asp-controller="@m.Ctrl"
                   asp-action="@(m.Act == "Create" ? "Create" : "Index")">
                    <span>@m.Icon</span>@m.Text
                </a>
            }
        </aside>

        <div class="ps-content">

            <!-- ============ THANH TRÊN ============ -->
            <header class="ps-top">
                <button class="btn btn-gh btn-sm ps-menu-btn" type="button" aria-label="Mở menu"
                        onclick="document.getElementById('sd').classList.toggle('on')">
                    ☰
                </button>

                <span style="color:var(--mu)">Trang chủ &nbsp;/&nbsp;</span>
                <b>@tenTrang</b>

                <div class="u">
                    <span class="ps-pill">@(isAdmin ? "Admin" : "Khách hàng")</span>
                    <a class="ps-av" asp-controller="TaiKhoans" asp-action="Details" title="@tenHienThi">@chuCai</a>
                    <a class="btn btn-gh btn-sm" asp-controller="TaiKhoans" asp-action="DangXuat">Đăng xuất</a>
                </div>
            </header>

            <!-- ============ NỘI DUNG CHÍNH ============ -->
            <main role="main" class="ps-main p-4">
                <div class="container-fluid p-0">
                    @RenderBody()
                </div>
            </main>

            <!-- ============ FOOTER CHUẨN PARKSMART ============ -->
            <footer class="park-footer">
                <div class="container-fluid px-4">
                    <div class="row gy-4">
                        <div class="col-12 col-md-3">
                            <div class="d-flex align-items-center gap-2 mb-2 text-white fw-bold fs-5">
                                <div style="width:32px; height:32px; background:#f5b400; color:#0b1f4d; border-radius:8px; display:grid; place-items:center; font-weight:800;">P</div>
                                <span>Quản lý bãi đỗ xe</span>
                            </div>
                            <p class="mb-0 text-light" style="font-size: 13px;">An toàn - Nhanh chóng - Tiện lợi</p>
                        </div>

                        <div class="col-12 col-md-3">
                            <h6>Thông tin liên hệ</h6>
                            <p class="mb-1"><i class="bi bi-telephone-fill me-2 text-warning"></i>Hotline: 1900 1900</p>
                            <p class="mb-1"><i class="bi bi-envelope-fill me-2 text-warning"></i>Email: UNETI03@baidoxe.vn</p>
                            <p class="mb-0"><i class="bi bi-geo-alt-fill me-2 text-warning"></i>Địa chỉ: 218 Lĩnh Nam, Hà Nội</p>
                        </div>

                        <div class="col-12 col-md-2">
                            <h6>Liên kết nhanh</h6>
                            <a href="#">Trang chủ</a>
                            <a href="#">Đăng ký gửi xe</a>
                            <a href="#">Quản lý xe</a>
                            <a href="#">Bãi đỗ xe</a>
                        </div>

                        <div class="col-12 col-md-2">
                            <h6>Hỗ trợ</h6>
                            <a href="#">Hướng dẫn sử dụng</a>
                            <a href="#">Câu hỏi thường gặp</a>
                            <a href="#">Chính sách bảo mật</a>
                            <a href="#">Điều khoản sử dụng</a>
                        </div>

                        <div class="col-12 col-md-2">
                            <h6>Kết nối với chúng tôi</h6>
                            <div class="d-flex gap-3 mb-3 fs-5">
                                <a href="#" class="text-secondary" title="Facebook"><i class="bi bi-facebook"></i></a>
                                <a href="#" class="text-secondary" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
                                <a href="#" class="text-secondary" title="YouTube"><i class="bi bi-youtube"></i></a>
                                <a href="#" class="text-secondary" title="Twitter"><i class="bi bi-twitter"></i></a>
                            </div>
                        </div>
                    </div>
                    <hr class="border-secondary my-3 opacity-25">
                    <div class="text-center text-muted" style="font-size: 12.5px;">
                        &copy; 2025 Quản lý bãi đỗ xe. Tất cả quyền được bảo lưu.
                    </div>
                </div>
            </footer>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
