                else
                {
                    <a class="nav-link" asp-controller="PhieuGuiXes" asp-action="Create"><i class="bi bi-car-front me-2"></i>Đăng ký gửi xe</a>
                    <a class="nav-link" asp-controller="PhuongTiens" asp-action="Index"><i class="bi bi-card-heading me-2"></i>Quản lý xe</a>
                    <a class="nav-link" asp-controller="ViTriDoXes" asp-action="Index"><i class="bi bi-p-square me-2"></i>Bãi đỗ xe</a>
                    <a class="nav-link" asp-controller="ChuPhuongTiens" asp-action="Index"><i class="bi bi-person me-2"></i>Khách hàng</a>
                    <a class="nav-link" asp-controller="PhieuGuiXes" asp-action="Index"><i class="bi bi-clock-history me-2"></i>Lịch sử gửi xe</a>
                }
            </nav>
