@* Lương Thị Quỳnh Hương - 23103100064 *@

@using Microsoft.AspNetCore.Http
@{
    string vaiTro = "Admin";
    try
    {
        if (Context.Session != null)
        {
            vaiTro = Context.Session.GetString("VaiTro") ?? "Admin";
        }
    }
    catch
    {
        vaiTro = "Admin";
    }
}<!DOCTYPE html><html lang="en"><head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuanLyBaiDoXe_UNETI03_TI17A2HN</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyBaiDoXe_UNETI03_TI17A2HN.styles.css" asp-append-version="true" />

    <style>
            body { background-color: #f4f6f9; }
            .sidebar { background-color: #ffffff; min-height: 100vh; border-right: 1px solid #dee2e6; }
            .sidebar a { color: #333; text-decoration: none; padding: 10px; display: block; border-radius: 6px; margin-bottom: 4px; }
            .sidebar a:hover, .sidebar a.active { background-color: #e8f1ff; color: #0d6efd; font-weight: bold; }
            .top-bar { background-color: #ffffff; border-bottom: 1px solid #dee2e6; padding: 12px 24px; }

            .main-footer {
                background-color: #f8fafd;
                border-top: 1px solid #e2e8f0;
                font-size: 13px;
                color: #6c757d;
            }
            .main-footer h6 {
                color: #212529;
                font-weight: 700;
                font-size: 14px;
                margin-bottom: 12px;
            }
            .main-footer a {
                color: #6c757d;
                text-decoration: none;
                display: block;
                margin-bottom: 6px;
            }
            .main-footer a:hover {
                color: #0d6efd;
            }
            .social-icons a {
                display: inline-block;
                font-size: 18px;
                margin-right: 12px;
                color: #495057;
            }
            .social-icons a:hover {
                color: #0d6efd;
            }
    </style></head><body>
    <div class="container-fluid p-0">
        <div class="row g-0">

            <div class="col-md-2 sidebar p-3">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-primary text-white rounded-2 d-flex align-items-center justify-content-center me-2 fw-bold fs-5" style="width: 36px; height: 36px;">P</div>
                    <div>
                        <h6 class="m-0 fw-bold">Quản lý bãi đỗ xe</h6>
                        <small class="text-muted" style="font-size: 11px;">Đăng ký gửi xe</small>
                    </div>
                </div>

                <nav class="nav flex-column">
                    <a class="nav-link active" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door me-2"></i>Trang chủ
                    </a>

                    @if (vaiTro == "Admin")
                    {
                        <div class="text-muted small fw-bold mt-2 mb-1 px-2">QUẢN TRỊ</div>
                        <a class="nav-link" asp-controller="LoaiPhuongTiens" asp-action="Index">
                            <i class="bi bi-tags me-2"></i>Loại phương tiện
                        </a>
                        <a class="nav-link" asp-controller="ViTriDoXes" asp-action="Index">
                            <i class="bi bi-p-square me-2"></i>Vị trí đỗ xe
                        </a>
                        <a class="nav-link" asp-controller="ChuPhuongTiens" asp-action="Index">
                            <i class="bi bi-people me-2"></i>Chủ phương tiện
                        </a>
                        <a class="nav-link" asp-controller="PhuongTiens" asp-action="Index">
                            <i class="bi bi-car-front me-2"></i>Quản lý phương tiện
                        </a>
                        <a class="nav-link" asp-controller="PhieuGuiXes" asp-action="Index">
                            <i class="bi bi-card-checklist me-2"></i>Quản lý phiếu gửi
                        </a>
                        <a class="nav-link" asp-controller="VaoRa" asp-action="Index">
                            <i class="bi bi-door-open me-2"></i>Vào/Ra
                        </a>
                        <a class="nav-link" asp-controller="ThongKe" asp-action="Index">
                            <i class="bi bi-bar-chart-line me-2"></i>Thống kê
                        </a> 
                    }
                    else
                    {
                        <a class="nav-link" asp-controller="PhieuGuiXes" asp-action="Create">
                            <i class="bi bi-car-front me-2"></i>Đăng ký gửi xe
                        </a>
                        <a class="nav-link" asp-controller="PhuongTiens" asp-action="Index">
                            <i class="bi bi-card-heading me-2"></i>Quản lý xe
                        </a>
                        <a class="nav-link" asp-controller="ViTriDoXes" asp-action="Index">
                            <i class="bi bi-p-square me-2"></i>Bãi đỗ xe
                        </a>
                        <a class="nav-link" asp-controller="ChuPhuongTiens" asp-action="Index">
                            <i class="bi bi-person me-2"></i>Khách hàng
                        </a>
                        <a class="nav-link" asp-controller="PhieuGuiXes" asp-action="Index">
                            <i class="bi bi-clock-history me-2"></i>Lịch sử gửi xe
                        </a>
                    }
                </nav>
            </div>

            <div class="col-md-10 d-flex flex-column min-vh-100">
                <div class="top-bar d-flex justify-content-end align-items-center gap-3">
                    <i class="bi bi-bell text-secondary fs-5" style="cursor:pointer;"></i>

                    <div class="dropdown">
                        <button class="btn btn-light dropdown-toggle d-flex align-items-center gap-2 border-0 bg-transparent p-0" 
                                type="button" 
                                data-bs-toggle="dropdown" 
                                aria-expanded="false">
                            <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center" style="width:32px; height:32px;">
                                <i class="bi bi-person"></i>
                            </div>
                            <span class="fw-medium">@vaiTro</span>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li>
                                <a class="dropdown-item" asp-controller="TaiKhoans" asp-action="Details">
                                    <i class="bi bi-person-lines-fill me-2 text-primary"></i>Xem tài khoản
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" asp-controller="TaiKhoans" asp-action="DangNhap">
                                    <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="p-4 flex-grow-1">
                    <main role="main" class="pb-3">
                        @RenderBody()
                    </main>
                </div>

                <footer class="main-footer p-4 mt-auto">
                    <div class="row gy-3">
                        <div class="col-md-3">
                            <div class="d-flex align-items-center mb-2">
                                <div class="bg-primary text-white rounded p-2 me-2 fw-bold fs-5 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">P</div>
                                <h6 class="m-0 fw-bold fs-6">Quản lý bãi đỗ xe</h6>
                            </div>
                            <small class="text-muted">An toàn - Nhanh chóng - Tiện lợi</small>
                        </div>

                        <div class="col-md-3">
                            <h6>Thông tin liên hệ</h6>
                            <div class="mb-1"><i class="bi bi-telephone-fill me-2"></i>Hotline: 1900 1900</div>
                            <div class="mb-1"><i class="bi bi-envelope-fill me-2"></i>Email: UNETI03@gmail.com.vn</div>
                            <div><i class="bi bi-geo-alt-fill me-2"></i>Địa chỉ: 218 Lĩnh Nam, Hà Nội</div>
                        </div>

                        <div class="col-md-2">
                            <h6>Liên kết nhanh</h6>
                            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                            <a asp-controller="PhieuGuiXes" asp-action="Create">Đăng ký gửi xe</a>
                            <a asp-controller="PhuongTiens" asp-action="Index">Quản lý xe</a>
                            <a asp-controller="ViTriDoXes" asp-action="Index">Bãi đỗ xe</a>
                        </div>

                        <div class="col-md-2">
                            <h6>Hỗ trợ</h6>
                            <a href="#">Hướng dẫn sử dụng</a>
                            <a href="#">Câu hỏi thường gặp</a>
                            <a href="#">Chính sách bảo mật</a>
                            <a href="#">Điều khoản sử dụng</a>
                        </div>

                        <div class="col-md-2">
                            <h6>Kết nối với chúng tôi</h6>
                            <div class="social-icons mb-3">
                                <a href="#"><i class="bi bi-facebook"></i></a>
                                <a href="#"><i class="bi bi-chat-dots-fill"></i></a>
                                <a href="#"><i class="bi bi-youtube"></i></a>
                                <a href="#"><i class="bi bi-globe"></i></a>
                            </div>
                            <small class="text-muted d-block">&copy; 2026 Quản lý bãi đỗ xe. Tất cả quyền được bảo lưu.</small>
                        </div>
                    </div>
                </footer>
            </div>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)</body></html>