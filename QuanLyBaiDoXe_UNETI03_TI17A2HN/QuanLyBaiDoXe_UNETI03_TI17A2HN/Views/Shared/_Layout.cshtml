            <div class="d-flex align-items-center mb-4">
                <div class="bg-primary text-white rounded-2 d-flex align-items-center justify-content-center me-2 fw-bold fs-5 flex-shrink-0" style="width: 38px; height: 38px;">P</div>
                <div class="overflow-hidden">
                    <h6 class="m-0 fw-bold text-truncate">Quản lý bãi đỗ xe</h6>
                    <small class="text-muted d-block text-truncate" style="font-size: 11px;">Đăng ký gửi xe</small>
                </div>
            </div>

            <nav class="nav flex-column gap-1">
                <a class="nav-link active" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door me-2"></i>Trang chủ
                </a>

                @if (vaiTro == "Admin")
                {
                    <div class="text-muted small fw-bold mt-2 mb-1 px-2">QUẢN TRỊ</div>
                    <a class="nav-link" asp-controller="LoaiPhuongTiens" asp-action="Index"><i class="bi bi-tags me-2"></i>Loại phương tiện</a>
                    <a class="nav-link" asp-controller="ViTriDoXes" asp-action="Index"><i class="bi bi-p-square me-2"></i>Vị trí đỗ xe</a>
                    <a class="nav-link" asp-controller="ChuPhuongTiens" asp-action="Index"><i class="bi bi-people me-2"></i>Chủ phương tiện</a>
                    <a class="nav-link" asp-controller="PhuongTiens" asp-action="Index"><i class="bi bi-car-front me-2"></i>Quản lý phương tiện</a>
                    <a class="nav-link" asp-controller="PhieuGuiXes" asp-action="Index"><i class="bi bi-card-checklist me-2"></i>Quản lý phiếu gửi</a>
                    <a class="nav-link" asp-controller="VaoRa" asp-action="Index"><i class="bi bi-door-open me-2"></i>Vào/Ra</a>
                    <a class="nav-link" asp-controller="ThongKe" asp-action="Index"><i class="bi bi-bar-chart-line me-2"></i>Thống kê</a>
