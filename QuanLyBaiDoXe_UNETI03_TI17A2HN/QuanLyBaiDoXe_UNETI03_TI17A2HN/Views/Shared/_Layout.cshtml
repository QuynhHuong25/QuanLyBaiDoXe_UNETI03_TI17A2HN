                        <a class="nav-link" asp-controller="PhuongTiens" asp-action="Index"><i class="bi bi-car-front me-2"></i>Quản lý phương tiện</a>
                        <a class="nav-link" asp-controller="PhieuGuiXes" asp-action="Index"><i class="bi bi-card-checklist me-2"></i>Quản lý phiếu gửi</a>
                        <a class="nav-link" asp-controller="VaoRa" asp-action="Index"><i class="bi bi-door-open me-2"></i>Vào/Ra</a>
                        <a class="nav-link" asp-controller="ThongKe" asp-action="Index"><i class="bi bi-bar-chart-line me-2"></i>Thống kê</a>
                    }
                    else
                    {
                        <a class="nav-link" asp-controller="PhieuGuiXes" asp-action="Create"><i class="bi bi-car-front me-2"></i>Đăng ký gửi xe</a>
                        <a class="nav-link" asp-controller="PhuongTiens" asp-action="Index"><i class="bi bi-card-heading me-2"></i>Quản lý xe</a>
                        <a class="nav-link" asp-controller="ViTriDoXes" asp-action="Index"><i class="bi bi-p-square me-2"></i>Bãi đỗ xe</a>
                        <a class="nav-link" asp-controller="ChuPhuongTiens" asp-action="Index"><i class="bi bi-person me-2"></i>Khách hàng</a>
                        <a class="nav-link" asp-controller="PhieuGuiXes" asp-action="Index"><i class="bi bi-clock-history me-2"></i>Lịch sử gửi xe</a>
                    }
                </nav>
            </div>
        </div>

        <div class="content-wrapper">
            
            <header class="top-bar d-flex justify-content-between align-items-center">
                <button class="btn btn-light border d-lg-none me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar" aria-label="Mở menu">
                    <i class="bi bi-list fs-5"></i>
                </button>

                <div class="ms-auto d-flex align-items-center gap-3">
                    <i class="bi bi-bell text-secondary fs-5" style="cursor:pointer;" title="Thông báo"></i>

                    <div class="dropdown">
                        <button class="btn btn-light dropdown-toggle d-flex align-items-center gap-2 border-0 bg-transparent p-0" 
                                type="button" 
                                data-bs-toggle="dropdown" 
                                aria-expanded="false">
                            <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:34px; height:34px;">
                                <i class="bi bi-person"></i>
                            </div>
                            <span class="fw-medium d-none d-sm-inline">@tenHienThi</span>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li>
                                <a class="dropdown-item" asp-controller="TaiKhoans" asp-action="Details">
                                    <i class="bi bi-person-lines-fill me-2 text-primary"></i>Xem tài khoản
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
