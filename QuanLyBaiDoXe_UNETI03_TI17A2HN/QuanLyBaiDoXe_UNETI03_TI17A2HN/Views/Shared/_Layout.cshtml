                        </div>

                        <div class="col-12 col-sm-6 col-lg-3">
                            <h6>Thông tin liên hệ</h6>
                            <div class="mb-1"><i class="bi bi-telephone-fill me-2"></i>Hotline: 1900 1900</div>
                            <div class="mb-1"><i class="bi bi-envelope-fill me-2"></i>Email: UNETI03@gmail.com.vn</div>
                            <div><i class="bi bi-geo-alt-fill me-2"></i>Địa chỉ: 218 Lĩnh Nam, Hà Nội</div>
                        </div>

                        <div class="col-6 col-sm-4 col-lg-2">
                            <h6>Liên kết nhanh</h6>
                            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                            <a asp-controller="PhieuGuiXes" asp-action="Create">Đăng ký gửi xe</a>
                            <a asp-controller="PhuongTiens" asp-action="Index">Quản lý xe</a>
