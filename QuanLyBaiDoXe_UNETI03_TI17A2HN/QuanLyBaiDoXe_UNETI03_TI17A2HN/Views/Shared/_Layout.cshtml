@* Lương Thị Quỳnh Hương - 23103100064 *@

@using Microsoft.AspNetCore.Http
@{
    string vaiTro = Context.Session?.GetString("VaiTro") ?? "Khach";
    string hoTen = Context.Session?.GetString("HoTen");
    string tenDangNhap = Context.Session?.GetString("TenDangNhap");

    string tenHienThi = !string.IsNullOrEmpty(hoTen) 
                        ? hoTen 
                        : (!string.IsNullOrEmpty(tenDangNhap) ? tenDangNhap : "Khách hàng");
}
<!DOCTYPE html>
<html lang="vi" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuanLyBaiDoXe_UNETI03_TI17A2HN</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyBaiDoXe_UNETI03_TI17A2HN.styles.css" asp-append-version="true" />

    <style>
        html, body {
            height: 100%;
            background-color: #f4f6f9;
        }

        .layout-wrapper {
            display: flex;
            min-height: 100vh;
            width: 100%;
            overflow-x: hidden;
        }

        .sidebar-desktop {
            width: 260px;
            flex-shrink: 0;
            background-color: #ffffff;
            border-right: 1px solid #dee2e6;
            padding: 1.25rem;
        }

        .content-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .sidebar nav a {
            color: #333;
            text-decoration: none;
            padding: 10px 14px;
            display: flex;
            align-items: center;
            border-radius: 8px;
            transition: all 0.2s ease-in-out;
        }

        .sidebar nav a:hover, .sidebar nav a.active {
            background-color: #e8f1ff;
            color: #0d6efd;
            font-weight: 600;
        }

        .top-bar {
            background-color: #ffffff;
            border-bottom: 1px solid #dee2e6;
            padding: 12px 24px;
        }

        .main-footer {
            background-color: #ffffff;
            border-top: 1px solid #e2e8f0;
            font-size: 13px;
            color: #6c757d;
        }

        .main-footer h6 {
            color: #212529;
            font-weight: 700;
            font-size: 14px;
            margin-bottom: 12px;
        }

        .main-footer a {
            color: #6c757d;
            text-decoration: none;
            display: block;
            margin-bottom: 6px;
        }

        .main-footer a:hover {
            color: #0d6efd;
        }

        .social-icons a {
            display: inline-block;
            font-size: 18px;
            margin-right: 12px;
            color: #495057;
        }

        .social-icons a:hover {
            color: #0d6efd;
        }
    </style>
</head>
<body class="h-100">

    <div class="layout-wrapper">

        <!-- Sidebar Desktop -->
